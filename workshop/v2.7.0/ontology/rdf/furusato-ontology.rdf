  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#GiftCategory__CategorySearchTerms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment>Pipe-delimited alias text holding the Japanese CategoryName, the English CategoryNameEn, and the literal marker gift category. Use it only to resolve colloquial return-gift category wording such as 海鮮系, 魚介, or seafood with a case-insensitive substring match. If CategoryName does not match, query this alias index before claiming no category data. Never display, group, count, or treat this property as the category identity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#GiftCategory" />
    <rdfs:label>CategorySearchTerms</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <fabric:businessRole>search-only alias index</fabric:businessRole>
    <fabric:displayPolicy>never display, group, or aggregate</fabric:displayPolicy>
    <fabric:format>{CategoryName} | {CategoryNameEn} | gift category</fabric:format>
    <fabric:grain>one value per GiftCategory</fabric:grain>
    <fabric:language>ja-JP,en</fabric:language>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"5394698403117272042","name":"CategorySearchTerms","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"search-only alias index","displayPolicy":"never display, group, or aggregate","format":"{CategoryName} | {CategoryNameEn} | gift category","grain":"one value per GiftCategory","language":"ja-JP,en","queryPattern":"FILTER lower(c.CategorySearchTerms) CONTAINS lower('&lt;alias&gt;')","sensitivity":"Public-Synthetic-Catalog"},"description":"Pipe-delimited alias text holding the Japanese CategoryName, the English CategoryNameEn, and the literal marker gift category. Use it only to resolve colloquial return-gift category wording such as 海鮮系, 魚介, or seafood with a case-insensitive substring match. If CategoryName does not match, query this alias index before claiming no category data. Never display, group, count, or treat this property as the category identity."},"valueType":"String"}</fabric:propertyDefinitionJson>
    <fabric:propertyId>5394698403117272042</fabric:propertyId>
    <fabric:propertyKind>static</fabric:propertyKind>
    <fabric:queryPattern>FILTER lower(c.CategorySearchTerms) CONTAINS lower('&lt;alias&gt;')</fabric:queryPattern>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"search-only alias index","displayPolicy":"never display, group, or aggregate","format":"{CategoryName} | {CategoryNameEn} | gift category","grain":"one value per GiftCategory","language":"ja-JP,en","queryPattern":"FILTER lower(c.CategorySearchTerms) CONTAINS lower('&lt;alias&gt;')","sensitivity":"Public-Synthetic-Catalog"},"description":"Pipe-delimited alias text holding the Japanese CategoryName, the English CategoryNameEn, and the literal marker gift category. Use it only to resolve colloquial return-gift category wording such as 海鮮系, 魚介, or seafood with a case-insensitive substring match. If CategoryName does not match, query this alias index before claiming no category data. Never display, group, count, or treat this property as the category identity."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public-Synthetic-Catalog</fabric:sensitivity>
    <fabric:valueType>String</fabric:valueType>
  </rdf:Description>
