  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#SupplierInPrefecture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment>Connects a synthetic Supplier to its registered Prefecture. Registered Supplier location is neither donor residence, Donation recipient geography, fulfillment location, service location, nor shipping origin.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Supplier" />
    <rdfs:label>SupplierInPrefecture</rdfs:label>
    <rdfs:range rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Prefecture" />
    <fabric:aggregationGuard>do not infer Donation recipient from Supplier location</fabric:aggregationGuard>
    <fabric:businessRole>supplier base geography</fabric:businessRole>
    <fabric:cardinality>many-to-one, exactly one Prefecture per Supplier</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"5538623819003650898","name":"SupplierInPrefecture","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"do not infer Donation recipient from Supplier location","businessRole":"supplier base geography","cardinality":"many-to-one, exactly one Prefecture per Supplier","direction":"Supplier -&gt; Prefecture","grain":"one edge per Supplier","sensitivity":"Synthetic-Organization","sourceParticipation":"mandatory - every Supplier carries exactly one edge","targetParticipation":"optional - a Prefecture may have zero Supplier rows"},"description":"Connects a synthetic Supplier to its registered Prefecture. Registered Supplier location is neither donor residence, Donation recipient geography, fulfillment location, service location, nor shipping origin."},"source":{"entityTypeId":"193544498857107"},"target":{"entityTypeId":"264514858427221"}}</fabric:definitionJson>
    <fabric:definitionPart>RelationshipTypes/5538623819003650898/definition.json</fabric:definitionPart>
    <fabric:direction>Supplier -&gt; Prefecture</fabric:direction>
    <fabric:grain>one edge per Supplier</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_818a3d10-42ab-48ee-963f-a180e3260519" />
    <fabric:relationshipTypeId>5538623819003650898</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"do not infer Donation recipient from Supplier location","businessRole":"supplier base geography","cardinality":"many-to-one, exactly one Prefecture per Supplier","direction":"Supplier -&gt; Prefecture","grain":"one edge per Supplier","sensitivity":"Synthetic-Organization","sourceParticipation":"mandatory - every Supplier carries exactly one edge","targetParticipation":"optional - a Prefecture may have zero Supplier rows"},"description":"Connects a synthetic Supplier to its registered Prefecture. Registered Supplier location is neither donor residence, Donation recipient geography, fulfillment location, service location, nor shipping origin."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Synthetic-Organization</fabric:sensitivity>
    <fabric:sourceParticipation>mandatory - every Supplier carries exactly one edge</fabric:sourceParticipation>
    <fabric:targetParticipation>optional - a Prefecture may have zero Supplier rows</fabric:targetParticipation>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#SupplierProvidesGift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment>Connects a Supplier, provider, vendor, 事業者, 業者, or 会社 to a Gift for which it is a registered provider. It does not prove an actual fulfillment, service, shipment, or physical origin. For a Gift-centered provider question, resolve the GiftId first and traverse this relationship in reverse from Gift to every registered Supplier, then use SupplierInPrefecture for registered location. The registration contract is many-to-many and optional on both sides: a Gift may have zero, one or many Suppliers and a Supplier may register zero, one or many Gifts. In this dataset every one of the 2,500 Suppliers and all 6,000 Gifts participate, across 14,514 unique pairs, so no orphan appears at run time. No allocation of DonationAmountYen among Suppliers is defined.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Supplier" />
    <rdfs:label>SupplierProvidesGift</rdfs:label>
    <rdfs:range rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift" />
    <fabric:aggregationGuard>do not sum DonationAmountYen across Suppliers without an explicit allocation rule because multi-supplier Gifts can duplicate attribution</fabric:aggregationGuard>
    <fabric:businessRole>catalog supply relationship</fabric:businessRole>
    <fabric:cardinality>many-to-many, zero-to-many on both sides by contract</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"5548279086455910756","name":"SupplierProvidesGift","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"do not sum DonationAmountYen across Suppliers without an explicit allocation rule because multi-supplier Gifts can duplicate attribution","businessRole":"catalog supply relationship","cardinality":"many-to-many, zero-to-many on both sides by contract","direction":"Supplier -&gt; Gift","grain":"one unique Supplier-Gift pair","sensitivity":"Public-Synthetic-Catalog","sourceParticipation":"optional by contract; total in this dataset - 0 Suppliers without a Gift","targetParticipation":"optional by contract; total in this dataset - 0 Gifts without a Supplier"},"description":"Connects a Supplier, provider, vendor, 事業者, 業者, or 会社 to a Gift for which it is a registered provider. It does not prove an actual fulfillment, service, shipment, or physical origin. For a Gift-centered provider question, resolve the GiftId first and traverse this relationship in reverse from Gift to every registered Supplier, then use SupplierInPrefecture for registered location. The registration contract is many-to-many and optional on both sides: a Gift may have zero, one or many Suppliers and a Supplier may register zero, one or many Gifts. In this dataset every one of the 2,500 Suppliers and all 6,000 Gifts participate, across 14,514 unique pairs, so no orphan appears at run time. No allocation of DonationAmountYen among Suppliers is defined."},"source":{"entityTypeId":"193544498857107"},"target":{"entityTypeId":"21065477330866"}}</fabric:definitionJson>
    <fabric:definitionPart>RelationshipTypes/5548279086455910756/definition.json</fabric:definitionPart>
    <fabric:direction>Supplier -&gt; Gift</fabric:direction>
    <fabric:grain>one unique Supplier-Gift pair</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_2803853a-f228-4fca-84a7-ae632c4218e8" />
    <fabric:relationshipTypeId>5548279086455910756</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"do not sum DonationAmountYen across Suppliers without an explicit allocation rule because multi-supplier Gifts can duplicate attribution","businessRole":"catalog supply relationship","cardinality":"many-to-many, zero-to-many on both sides by contract","direction":"Supplier -&gt; Gift","grain":"one unique Supplier-Gift pair","sensitivity":"Public-Synthetic-Catalog","sourceParticipation":"optional by contract; total in this dataset - 0 Suppliers without a Gift","targetParticipation":"optional by contract; total in this dataset - 0 Gifts without a Supplier"},"description":"Connects a Supplier, provider, vendor, 事業者, 業者, or 会社 to a Gift for which it is a registered provider. It does not prove an actual fulfillment, service, shipment, or physical origin. For a Gift-centered provider question, resolve the GiftId first and traverse this relationship in reverse from Gift to every registered Supplier, then use SupplierInPrefecture for registered location. The registration contract is many-to-many and optional on both sides: a Gift may have zero, one or many Suppliers and a Supplier may register zero, one or many Gifts. In this dataset every one of the 2,500 Suppliers and all 6,000 Gifts participate, across 14,514 unique pairs, so no orphan appears at run time. No allocation of DonationAmountYen among Suppliers is defined."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public-Synthetic-Catalog</fabric:sensitivity>
    <fabric:sourceParticipation>optional by contract; total in this dataset - 0 Suppliers without a Gift</fabric:sourceParticipation>
    <fabric:targetParticipation>optional by contract; total in this dataset - 0 Gifts without a Supplier</fabric:targetParticipation>
  </rdf:Description>
