		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_format = "integer ID"
		annotation Furusato_fulfillmentRole = "none"
		annotation Furusato_grain = "one Supplier"

		backingConfiguration
			valueColumn: ot_supplier.SupplierId

	/// Synthetic Japanese organization-style name of the Supplier or vendor (事業者名／提供事業者名). It is not a Donation recipient.
	property SupplierName
