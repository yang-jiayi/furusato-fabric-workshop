furusato:Gift fabric:definitionJson "{\"$schema\":\"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json\",\"baseEntityTypeId\":null,\"displayNamePropertyId\":\"5416054540626218197\",\"entityIdParts\":[\"5416054538545251650\"],\"id\":\"21065477330866\",\"name\":\"Gift\",\"namespace\":\"usertypes\",\"namespaceType\":\"Custom\",\"properties\":[{\"baseTypeNamespaceType\":null,\"id\":\"5416054538545251650\",\"name\":\"GiftId\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"stable entity identifier\",\"defaultAggregation\":\"none\",\"format\":\"integer ID\",\"grain\":\"one Gift\"},\"description\":\"Stable numeric identifier for one Gift catalog entity. Use it to connect Donations, catalog Municipalities, categories, and registered Suppliers.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"5416054537989576852\",\"name\":\"GiftName\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"Japanese label\",\"defaultAggregation\":\"none\",\"format\":\"Japanese text\",\"grain\":\"one value per Gift\",\"language\":\"ja-JP\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Core Japanese product or service name of the return-gift option (返礼品名／お礼品名／商品名). It usually opens with a place-of-origin word such as a prefecture name, which is display text and not authoritative geography. For a Municipality-qualified colloquial label, traverse MunicipalityCatalogsGift first, filter this property with CONTAINS on the core noun, and verify the remaining numeric and descriptive tokens. Core names can repeat, so resolve one stable GiftId before further traversal.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5416054540626218197\",\"name\":\"GiftDisplayName\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"display label\",\"defaultAggregation\":\"none\",\"format\":\"{GiftName} / Gift {GiftId}\",\"grain\":\"one value per Gift\",\"language\":\"ja-JP\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Display-only composite in the format {GiftName} / Gift {GiftId}. Use it for unambiguous human-readable output and GiftId as the stable identity.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"196401923428015932\",\"name\":\"GiftSearchTerms\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"search-only Gift resolver\",\"defaultAggregation\":\"none\",\"displayPolicy\":\"never display, group, or aggregate\",\"format\":\"{GiftName} | {GiftNameEn} | {CategoryName} | {CategoryNameEn}\",\"grain\":\"one value per Gift\",\"language\":\"ja-JP,en\",\"queryPattern\":\"FILTER lower(g.GiftSearchTerms) CONTAINS lower('<distinctive token>') for every supplied token\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Pipe-delimited search-only text for resolving shortened or colloquial Gift wording. It contains the core GiftName, the English GiftNameEn, the Japanese CategoryName, and the English CategoryNameEn. Place-of-origin words often appear inside those name strings, but they are display text and not authoritative geography, so resolve catalog and recipient geography through MunicipalityCatalogsGift and DonationToMunicipality. Filter it with a case-insensitive substring match for every distinctive noun supplied by the user; never display, group, count, or treat it as Gift identity.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5416054541651706320\",\"name\":\"GiftNotes\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"descriptive text\",\"defaultAggregation\":\"none\",\"format\":\"free text\",\"grain\":\"one value per Gift\",\"language\":\"ja-JP\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Japanese free-text note, notes, remarks, or description for the return-gift option (備考／注意事項／説明). Notes are descriptive only and do not define Supplier, recipient geography, category, or monetary amount.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"770784031709312495\",\"name\":\"GiftStaticCount\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"gift snapshot metric\",\"defaultAggregation\":\"none\",\"grain\":\"one Gift\",\"measure\":\"count of Donation\",\"queryPolicy\":\"select directly from the resolved Gift without traversing any relationship\"},\"description\":\"Authoritative pre-aggregated count of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift count; do not join Suppliers or recount Donation detail.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"562907930706153922\",\"name\":\"GiftStaticTotalYen\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"gift snapshot metric\",\"defaultAggregation\":\"none\",\"grain\":\"one Gift\",\"queryPolicy\":\"select directly from the resolved Gift without traversing any relationship\",\"unit\":\"JPY\"},\"description\":\"Authoritative pre-aggregated JPY amount of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift total; do not join Suppliers or use SUM(DISTINCT DonationAmountYen).\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"753534949855484163\",\"name\":\"GiftAmountRank\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"gift amount rank\",\"defaultAggregation\":\"none\",\"grain\":\"one Gift\",\"rankMethod\":\"row_number\",\"rankPartition\":\"none (single global window)\",\"rankScope\":\"all Gifts\",\"rankSort\":\"GiftStaticTotalYen desc, GiftId asc\",\"rankTieBreak\":\"GiftId ascending\"},\"description\":\"Static donation-amount rank of this Gift across all Gifts. Deterministic row-number rank (row_number) over GiftStaticTotalYen desc, GiftId asc: equal amounts never share a rank because GiftId breaks the tie ascending.\"},\"valueType\":\"BigInt\"}],\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"catalog item dimension\",\"grain\":\"one return-gift option\",\"monetaryRole\":\"none\",\"recipientPath\":\"DonationToMunicipality only\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Synthetic return-gift option selected by a Donation (返礼品／お礼品／商品). It is a catalog dimension, not the donated money and not a transaction fact. If a Municipality is named, resolve that Municipality and traverse MunicipalityCatalogsGift before applying a GiftName CONTAINS candidate filter. Resolve exactly one stable GiftId before Supplier or Donation traversal.\",\"synonyms\":[\"gift\",\"return gift\",\"return gifts\",\"thank-you gift\",\"reward\",\"benefit\",\"perk\",\"gift option\",\"hometown tax gift\",\"返礼品\",\"お礼品\",\"商品\",\"特典\",\"返礼品オプション\"]},\"timeseriesProperties\":[],\"untypedProperties\":[],\"visibility\":\"Visible\"}" .
