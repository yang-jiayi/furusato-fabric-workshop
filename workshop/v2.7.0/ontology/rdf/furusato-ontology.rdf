    <fabric:aggregationGuard>aggregate Donation facts, not Gift or edge counts</fabric:aggregationGuard>
    <fabric:businessRole>catalog classification</fabric:businessRole>
    <fabric:cardinality>many-to-one, exactly one GiftCategory per Gift</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"5541717777652180049","name":"GiftInCategory","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"aggregate Donation facts, not Gift or edge counts","businessRole":"catalog classification","cardinality":"many-to-one, exactly one GiftCategory per Gift","direction":"Gift -&gt; GiftCategory","grain":"one edge per Gift","sensitivity":"Public-Synthetic-Catalog","sourceParticipation":"mandatory - every Gift carries exactly one edge","targetParticipation":"optional - a GiftCategory may have zero Gift rows"},"description":"Classifies a Gift in exactly one GiftCategory. Category-level donation metrics must traverse DonationSelectedGift first and aggregate DonationAmountYen from Donation."},"source":{"entityTypeId":"21065477330866"},"target":{"entityTypeId":"135818208486705"}}</fabric:definitionJson>
    <fabric:definitionPart>RelationshipTypes/5541717777652180049/definition.json</fabric:definitionPart>
    <fabric:direction>Gift -&gt; GiftCategory</fabric:direction>
    <fabric:grain>one edge per Gift</fabric:grain>
