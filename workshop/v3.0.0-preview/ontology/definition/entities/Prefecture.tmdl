		annotation Furusato_grain = "one Prefecture"
		annotation Furusato_snapshotScope = "current static Donation only"
		annotation Furusato_unit = "JPY"

		backingConfiguration
			valueColumn: ot_prefecture.PrefReceivedTotalYen

	/// Received-amount rank of this Prefecture across all Prefectures. Deterministic row-number rank (row_number) over PrefReceivedTotalYen desc, PrefectureId asc: equal amounts never share a rank because PrefectureId breaks the tie ascending.
	property PrefReceivedAmountRank
		dataType: int64
		lineageTag: b0e8c775-0d23-5f1d-89ff-3928e5ee2839
		annotation Furusato_businessRole = "received amount rank"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_grain = "one Prefecture"
		annotation Furusato_rankMethod = "row_number"
		annotation Furusato_rankPartition = "none (single global window)"
		annotation Furusato_rankScope = "all Prefectures"
		annotation Furusato_rankSort = "PrefReceivedTotalYen desc, PrefectureId asc"
		annotation Furusato_rankTieBreak = "PrefectureId ascending"
		annotation Furusato_sort = "amount descending"

		backingConfiguration
			valueColumn: ot_prefecture.PrefReceivedAmountRank

