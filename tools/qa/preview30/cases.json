{
  "schema_version": "furusato-preview30-cases/v1",
  "suite_kind": "new_features",
  "states": ["planned", "implemented", "deployed", "pass", "fail", "blocked", "unsupported", "unverified"],
  "original_inventory": {"questions": 10, "conditions": 84, "independent_hidden": false, "modified": false},
  "policy": {
    "ai_repeats": 3,
    "max_candidates": 2,
    "stop_identical_failure_after": 2,
    "no_questions_accuracy": null,
    "missing_evidence_is_failure_score": false,
    "critical_truth_before_aggregate": true,
    "evaluator_cloud_writes": false,
    "heldout_location": "private evidence root only; never attachments"
  },
  "cases": [
    {
      "id": "SCOPE01", "category": "data", "critical": true,
      "title": "Verified folder, identity and source readiness",
      "roles": {"scope": "scope_receipt", "readiness": "source_query"},
      "checks": ["numeric_folder_mapping", "all_items_allowlisted", "principal_and_folder_readback", "no_stale_participant_or_forbidden_source"],
      "required_items": ["lakehouse"],
      "notes": "A similar date/name or an old participant run does not identify the authorized scope."
    },
    {
      "id": "DATA01", "category": "data", "critical": true,
      "title": "Static source totals, dates, types and donation grain",
      "roles": {"totals": "source_query", "schema": "source_query"},
      "checks": ["immutable_fixture", "source_total_and_count", "unique_donation_keys", "utc_period_and_native_types", "no_supplier_fanout_sum"],
      "required_items": ["lakehouse"],
      "oracle_assertions": ["static.rows", "static.amount_yen", "static.unique_donation_ids", "static.from_utc", "static.to_utc"]
    },
    {
      "id": "DATA02", "category": "data", "critical": true,
      "title": "Operational raw observations versus accepted events",
      "roles": {"raw": "source_query", "accepted": "source_query", "schema": "source_query"},
      "checks": ["all_three_files_and_run_scope", "raw_count_not_bucket_count", "raw_and_accepted_amounts_separate", "duplicate_event_ids", "utc_period_and_types", "no_static_plus_operational_sum"],
      "required_items": ["kql_database", "lakehouse"],
      "oracle_assertions": ["increment.raw_rows", "increment.unique_event_ids", "increment.duplicate_event_ids", "increment.raw_amount_yen", "increment.accepted_amount_yen", "increment.from_utc", "increment.to_utc"]
    },
    {
      "id": "UI01", "category": "structural", "critical": true,
      "title": "Genuine new experience with saved definition",
      "roles": {"screen": "ui_capture", "item": "capability_probe", "readback": "definition"},
      "checks": ["new_ui_not_legacy", "native_generation_two", "gen2_tmdl_not_legacy_json", "actual_item_identity", "saved_definition_matches_screen", "readable_authentic_capture"],
      "required_items": ["ontology"],
      "notes": "Require the actual Get Ontology properties.generation value 2 and gen2 TMDL readback. Logical teaching metadata from legacy EntityTypes JSON is not proof of the new experience."
    },
    {
      "id": "UI02", "category": "structural", "critical": true,
      "title": "Correct bindings, data types and identity grain",
      "roles": {"binding": "definition", "schema": "source_query", "grain": "source_query", "screen": "ui_capture", "functional": "operation_receipt"},
      "checks": ["workspace_item_table_column_identity", "source_types_and_periods_preserved", "all_key_parts", "entity_grain_not_display_name", "keyless_limits_explicit", "native_instances_functional_readback"],
      "required_items": ["ontology", "lakehouse"],
      "notes": "Schema, source-column labels and direct SQL success do not prove that the ontology binding can resolve and read the source. Require actual native Instances/ontology-bound results; retain source-kind errors as functional failures."
    },
    {
      "id": "UI03", "category": "structural", "critical": true,
      "title": "Relationship direction, keys and many-to-many fanout",
      "roles": {"relationship": "definition", "join": "source_query"},
      "checks": ["direction_preserved", "composite_join_all_parts", "relationship_grain", "orphan_and_fanout_checks", "catalog_not_fulfillment"],
      "required_items": ["ontology", "lakehouse"]
    },
    {
      "id": "METRIC01", "category": "data", "critical": true,
      "title": "Model-owned DAX surfaced as Metrics",
      "roles": {"model": "definition", "metric": "definition", "dax": "source_query", "source": "source_query", "screen": "ui_capture"},
      "checks": ["named_model_connection_identity", "measure_owned_by_model", "native_projection_or_enrichment_link", "no_explicit_dax_metric", "tmdl_backing_measure_gap_not_hidden", "actual_dax_not_prose", "filters_period_grain_equal", "source_reconciliation"],
      "required_items": ["semantic_model", "ontology", "lakehouse"],
      "required_languages": ["DAX", "SQL"],
      "notes": "Projected/enrichment backingMeasure cannot round-trip TMDL. Require a real native-UI or documented public-contract metric link; merely adding a table DAX measure does not create a Metric."
    },
    {
      "id": "RULE01", "category": "structural", "critical": true,
      "title": "Natural-language Rules definition before and after",
      "roles": {"before": "definition", "after": "definition", "screen": "ui_capture"},
      "checks": ["scoped_definition_delta", "business_rule_language_preserved", "no_executable_constraint_claim", "no_activator_action_claim", "source_unchanged"],
      "required_items": ["ontology"]
    },
