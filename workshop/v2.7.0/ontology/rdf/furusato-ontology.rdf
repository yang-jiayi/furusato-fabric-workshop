  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#MunHasCategoryMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment>Connects a Municipality to each MunicipalityCategoryMetric row for that recipient Municipality. A Municipality that received no Donation has no metric row at all: 10 of the 1,741 Municipalities have none.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Municipality" />
    <rdfs:label>MunHasCategoryMetric</rdfs:label>
    <rdfs:range rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#MunicipalityCategoryMetric" />
    <fabric:aggregationGuard>read metric values once and do not traverse to Donation detail for the same total</fabric:aggregationGuard>
    <fabric:businessRole>recipient Municipality to pre-aggregated category metric</fabric:businessRole>
    <fabric:cardinality>zero-to-many from Municipality, exactly one Municipality per MunicipalityCategoryMetric row</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"7253105300430015676","name":"MunHasCategoryMetric","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"read metric values once and do not traverse to Donation detail for the same total","businessRole":"recipient Municipality to pre-aggregated category metric","cardinality":"zero-to-many from Municipality, exactly one Municipality per MunicipalityCategoryMetric row","direction":"Municipality -&gt; MunicipalityCategoryMetric","grain":"one edge per metric row","sensitivity":"Public","sourceParticipation":"optional - 10 Municipalities have no metric row","targetParticipation":"mandatory - every metric row has exactly one Municipality"},"description":"Connects a Municipality to each MunicipalityCategoryMetric row for that recipient Municipality. A Municipality that received no Donation has no metric row at all: 10 of the 1,741 Municipalities have none."},"source":{"entityTypeId":"57727254480397"},"target":{"entityTypeId":"231502701063348"}}</fabric:definitionJson>
    <fabric:definitionPart>RelationshipTypes/7253105300430015676/definition.json</fabric:definitionPart>
    <fabric:direction>Municipality -&gt; MunicipalityCategoryMetric</fabric:direction>
    <fabric:grain>one edge per metric row</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_7d61e8a2-b9a1-43b6-8348-774d10c52583" />
    <fabric:relationshipTypeId>7253105300430015676</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"read metric values once and do not traverse to Donation detail for the same total","businessRole":"recipient Municipality to pre-aggregated category metric","cardinality":"zero-to-many from Municipality, exactly one Municipality per MunicipalityCategoryMetric row","direction":"Municipality -&gt; MunicipalityCategoryMetric","grain":"one edge per metric row","sensitivity":"Public","sourceParticipation":"optional - 10 Municipalities have no metric row","targetParticipation":"mandatory - every metric row has exactly one Municipality"},"description":"Connects a Municipality to each MunicipalityCategoryMetric row for that recipient Municipality. A Municipality that received no Donation has no metric row at all: 10 of the 1,741 Municipalities have none."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public</fabric:sensitivity>
    <fabric:sourceParticipation>optional - 10 Municipalities have no metric row</fabric:sourceParticipation>
    <fabric:targetParticipation>mandatory - every metric row has exactly one Municipality</fabric:targetParticipation>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#MunMetricForCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment>Connects a MunicipalityCategoryMetric row to its GiftCategory.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#MunicipalityCategoryMetric" />
    <rdfs:label>MunMetricForCategory</rdfs:label>
    <rdfs:range rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#GiftCategory" />
    <fabric:aggregationGuard>metric is already aggregated at Municipality x GiftCategory grain</fabric:aggregationGuard>
    <fabric:businessRole>pre-aggregated category metric to its GiftCategory</fabric:businessRole>
    <fabric:cardinality>many-to-one, exactly one GiftCategory per MunicipalityCategoryMetric row</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"7257127959125760568","name":"MunMetricForCategory","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"metric is already aggregated at Municipality x GiftCategory grain","businessRole":"pre-aggregated category metric to its GiftCategory","cardinality":"many-to-one, exactly one GiftCategory per MunicipalityCategoryMetric row","direction":"MunicipalityCategoryMetric -&gt; GiftCategory","grain":"one edge per metric row","sensitivity":"Public","sourceParticipation":"mandatory - every MunicipalityCategoryMetric carries exactly one edge","targetParticipation":"optional - a GiftCategory may have zero MunicipalityCategoryMetric rows"},"description":"Connects a MunicipalityCategoryMetric row to its GiftCategory."},"source":{"entityTypeId":"231502701063348"},"target":{"entityTypeId":"135818208486705"}}</fabric:definitionJson>
    <fabric:definitionPart>RelationshipTypes/7257127959125760568/definition.json</fabric:definitionPart>
    <fabric:direction>MunicipalityCategoryMetric -&gt; GiftCategory</fabric:direction>
    <fabric:grain>one edge per metric row</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_bf3c5624-ce6b-44c3-b7da-a12f957e47c9" />
    <fabric:relationshipTypeId>7257127959125760568</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"metric is already aggregated at Municipality x GiftCategory grain","businessRole":"pre-aggregated category metric to its GiftCategory","cardinality":"many-to-one, exactly one GiftCategory per MunicipalityCategoryMetric row","direction":"MunicipalityCategoryMetric -&gt; GiftCategory","grain":"one edge per metric row","sensitivity":"Public","sourceParticipation":"mandatory - every MunicipalityCategoryMetric carries exactly one edge","targetParticipation":"optional - a GiftCategory may have zero MunicipalityCategoryMetric rows"},"description":"Connects a MunicipalityCategoryMetric row to its GiftCategory."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public</fabric:sensitivity>
    <fabric:sourceParticipation>mandatory - every MunicipalityCategoryMetric carries exactly one edge</fabric:sourceParticipation>
    <fabric:targetParticipation>optional - a GiftCategory may have zero MunicipalityCategoryMetric rows</fabric:targetParticipation>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Municipality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Japanese municipality (自治体／市区町村) that may receive zero or more Donations. It also keys operational time-series observations; those observations are not Donation entities and have no Donor, Gift, or Supplier identity.</rdfs:comment>
    <rdfs:label>Municipality</rdfs:label>
    <skos:altLabel>city</skos:altLabel>
    <skos:altLabel>donation destination</skos:altLabel>
    <skos:altLabel>local authority</skos:altLabel>
    <skos:altLabel>local government</skos:altLabel>
    <skos:altLabel>municipalities</skos:altLabel>
    <skos:altLabel>municipality</skos:altLabel>
    <skos:altLabel>recipient municipality</skos:altLabel>
    <skos:altLabel>town</skos:altLabel>
    <skos:altLabel>village</skos:altLabel>
    <skos:altLabel>ward</skos:altLabel>
    <skos:altLabel>受入自治体</skos:altLabel>
    <skos:altLabel>寄付先自治体</skos:altLabel>
    <skos:altLabel>寄附先自治体</skos:altLabel>
    <skos:altLabel>市区町村</skos:altLabel>
    <skos:altLabel>自治体</skos:altLabel>
    <fabric:businessRole>recipient geography dimension</fabric:businessRole>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json","baseEntityTypeId":null,"displayNamePropertyId":"5318995285645577870","entityIdParts":["5318995285286504502"],"id":"57727254480397","name":"Municipality","namespace":"usertypes","namespaceType":"Custom","properties":[{"baseTypeNamespaceType":null,"id":"5318995285286504502","name":"MunicipalityId","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"stable entity identifier","defaultAggregation":"none","format":"string ID","grain":"one Municipality"},"description":"Stable identifier for one Municipality entity. Preserve leading zeros if present and use it as the relationship key; do not aggregate it."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5318995282168547313","name":"MunicipalityName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese label","defaultAggregation":"none","format":"Japanese text","grain":"one value per Municipality","language":"ja-JP","sensitivity":"Public"},"description":"Japanese municipality name (自治体名／市区町村名) without a prefecture qualifier. Names are not globally unique, so include MunicipalityId or MunicipalityDisplayName when ambiguity is possible."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5318995285645577870","name":"MunicipalityDisplayName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"display label","defaultAggregation":"none","format":"{MunicipalityName} / {PrefectureName}","grain":"one value per Municipality","language":"ja-JP","sensitivity":"Public"},"description":"Display-only composite label in the format {MunicipalityName} / {PrefectureName}. It does not contain MunicipalityId, so use MunicipalityId as the identity and this property only for human-readable output."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"161332579511618620","name":"MunicipalityStaticCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"received snapshot metric","defaultAggregation":"none","grain":"one Municipality","measure":"count of Donation"},"description":"Pre-aggregated count of static Donations received by this Municipality."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"179770367015274997","name":"MunicipalityStaticTotalYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"received snapshot metric","defaultAggregation":"none","grain":"one Municipality","unit":"JPY"},"description":"Pre-aggregated static Donation amount received by this Municipality in JPY."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"787769671224469935","name":"MunicipalityAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"received amount rank","defaultAggregation":"none","grain":"one Municipality","rankMethod":"row_number","rankPartition":"none (single global window)","rankScope":"all Municipalities","rankSort":"MunicipalityStaticTotalYen desc, MunicipalityId asc","rankTieBreak":"MunicipalityId ascending"},"description":"Received-amount rank of this Municipality across all Municipalities. Deterministic row-number rank (row_number) over MunicipalityStaticTotalYen desc, MunicipalityId asc: equal amounts never share a rank because MunicipalityId breaks the tie ascending."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"168756737285027664","name":"MunicipalityPrefAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"received amount rank","defaultAggregation":"none","grain":"one Municipality","rankMethod":"row_number","rankPartition":"PrefectureId","rankScope":"within containing Prefecture","rankSort":"MunicipalityStaticTotalYen desc, MunicipalityId asc","rankTieBreak":"MunicipalityId ascending"},"description":"Received-amount rank of this Municipality inside its containing Prefecture. Deterministic row-number rank (row_number) over MunicipalityStaticTotalYen desc, MunicipalityId asc within each PrefectureId: equal amounts never share a rank because MunicipalityId breaks the tie ascending."},"valueType":"BigInt"}],"semanticEnrichment":{"customAttributes":{"businessRole":"recipient geography dimension","factPolicy":"Donation is the transaction fact","grain":"one entity per Japanese municipality","sensitivity":"Public","timeSeriesRole":"context key only"},"description":"Japanese municipality (自治体／市区町村) that may receive zero or more Donations. It also keys operational time-series observations; those observations are not Donation entities and have no Donor, Gift, or Supplier identity.","synonyms":["municipality","municipalities","recipient municipality","donation destination","local government","local authority","city","town","village","ward","自治体","市区町村","受入自治体","寄付先自治体","寄附先自治体"]},"timeseriesProperties":[{"baseTypeNamespaceType":null,"id":"5823284714213132117","name":"IncomingDonationAmountYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"operational time-series measure","deduplication":"none - raw ingested rows; duplicate EventIDs retained","defaultAggregation":"SUM only within an explicitly requested time-series scope","grain":"one ingested event observation for one Municipality","numericAuthority":"Eventhouse curated view; this property is a modeled mirror","sensitivity":"Synthetic-Transaction","sourceTable":"DonationEvents (raw), not DonationObservationSummaryForAgent","staticFactPolicy":"must not be combined with Donation entity counts or amounts","timezone":"event timestamp DonatedAt is UTC","unit":"JPY"},"description":"Donation amount observed in an operational Municipality time-series event. It binds to the raw ingested DonationEvents rows through DonatedAt and DonationAmountYen, so its values are raw observations: deduplication = none, and duplicate EventIDs are retained. It is measured in JPY but is not a static Donation entity property; never use it to increase Donation entity counts or to identify a Donor, Gift, Supplier, or DonationId. The Eventhouse remains the numeric authority for operational observation metrics; this property is a modeled mirror of them."},"valueType":"BigInt"}],"untypedProperties":[],"visibility":"Visible"}</fabric:definitionJson>
    <fabric:definitionPart>EntityTypes/57727254480397/definition.json</fabric:definitionPart>
    <fabric:displayNameProperty rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Municipality__MunicipalityDisplayName" />
    <fabric:entityTypeId>57727254480397</fabric:entityTypeId>
    <fabric:factPolicy>Donation is the transaction fact</fabric:factPolicy>
    <fabric:grain>one entity per Japanese municipality</fabric:grain>
    <fabric:hasDataBinding rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#binding_8f3fdd32-b7ea-494b-baca-61b8519e9741" />
    <fabric:hasDataBinding rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#binding_dd4b367d-8eac-4861-b06a-1912756ad70b" />
    <fabric:hasOverview rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#overview_57727254480397" />
