    <fabric:direction>residence Prefecture -&gt; PrefectureDonationFlow</fabric:direction>
    <fabric:geographyRole>origin donor residence</fabric:geographyRole>
    <fabric:grain>one edge per flow row</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_42e33025-9699-4603-8235-23e84a31477a" />
    <fabric:relationshipTypeId>7265812375370015816</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"flow rows are already aggregated at residence x recipient Prefecture grain","businessRole":"donor-residence origin of a pre-aggregated prefecture flow","cardinality":"one-to-many from Prefecture, exactly one residence Prefecture per PrefectureDonationFlow row","direction":"residence Prefecture -&gt; PrefectureDonationFlow","geographyRole":"origin donor residence","grain":"one edge per flow row","sensitivity":"Public","sourceParticipation":"mandatory - every one of the 47 Prefectures originates at least one flow row","targetParticipation":"mandatory - every flow row has exactly one residence Prefecture"},"description":"Connects the Donor-residence Prefecture to an origin-destination PrefectureDonationFlow row."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public</fabric:sensitivity>
    <fabric:sourceParticipation>mandatory - every one of the 47 Prefectures originates at least one flow row</fabric:sourceParticipation>
