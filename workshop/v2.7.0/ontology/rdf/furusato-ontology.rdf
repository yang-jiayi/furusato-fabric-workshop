    <fabric:defaultAggregation>SUM</fabric:defaultAggregation>
    <fabric:format>whole-yen integer</fabric:format>
    <fabric:grain>one value per Donation</fabric:grain>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"5483655104000010925","name":"DonationAmountYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"additive fact measure","defaultAggregation":"SUM","format":"whole-yen integer","grain":"one value per Donation","sensitivity":"Synthetic-Transaction","unit":"JPY"},"description":"Completed donation amount (寄付金額／寄附金額／納税額) in whole Japanese yen for exactly one static Donation. SUM this property for donation totals and never sum IDs or Municipality time-series observations into the same result."},"valueType":"BigInt"}</fabric:propertyDefinitionJson>
    <fabric:propertyId>5483655104000010925</fabric:propertyId>
    <fabric:propertyKind>static</fabric:propertyKind>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"additive fact measure","defaultAggregation":"SUM","format":"whole-yen integer","grain":"one value per Donation","sensitivity":"Synthetic-Transaction","unit":"JPY"},"description":"Completed donation amount (寄付金額／寄附金額／納税額) in whole Japanese yen for exactly one static Donation. SUM this property for donation totals and never sum IDs or Municipality time-series observations into the same result."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Synthetic-Transaction</fabric:sensitivity>
    <fabric:unit>JPY</fabric:unit>
    <fabric:valueType>BigInt</fabric:valueType>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donation__DonationDataLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment>Canonical layer label for this detail entity. Its only value is StaticSyntheticSnapshot, which is not a payment method or a time-series event type. The constant is a deliberate exception to the rule that a single-valued column carries no information: it is the declared boundary marker that keeps the static snapshot separable from the operational observation layer, so a query can never silently blend the two. Never filter it away, never group by it, and never present it as a lifecycle or approval state.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donation" />
    <rdfs:label>DonationDataLayer</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <fabric:boundaryRole>static-versus-observation layer marker</fabric:boundaryRole>
    <fabric:businessRole>data layer discriminator</fabric:businessRole>
    <fabric:canonicalValue>StaticSyntheticSnapshot</fabric:canonicalValue>
    <fabric:constantByDesign>true</fabric:constantByDesign>
    <fabric:defaultAggregation>none</fabric:defaultAggregation>
    <fabric:grain>one Donation</fabric:grain>
    <fabric:modelingException>a single-valued technical property is retained on purpose so the static layer is explicit in every projection</fabric:modelingException>
    <fabric:paymentMethodRole>none</fabric:paymentMethodRole>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"177982238026863913","name":"DonationDataLayer","redefines":null,"semanticEnrichment":{"customAttributes":{"boundaryRole":"static-versus-observation layer marker","businessRole":"data layer discriminator","canonicalValue":"StaticSyntheticSnapshot","constantByDesign":"true","defaultAggregation":"none","grain":"one Donation","modelingException":"a single-valued technical property is retained on purpose so the static layer is explicit in every projection","paymentMethodRole":"none"},"description":"Canonical layer label for this detail entity. Its only value is StaticSyntheticSnapshot, which is not a payment method or a time-series event type. The constant is a deliberate exception to the rule that a single-valued column carries no information: it is the declared boundary marker that keeps the static snapshot separable from the operational observation layer, so a query can never silently blend the two. Never filter it away, never group by it, and never present it as a lifecycle or approval state."},"valueType":"String"}</fabric:propertyDefinitionJson>
    <fabric:propertyId>177982238026863913</fabric:propertyId>
    <fabric:propertyKind>static</fabric:propertyKind>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"boundaryRole":"static-versus-observation layer marker","businessRole":"data layer discriminator","canonicalValue":"StaticSyntheticSnapshot","constantByDesign":"true","defaultAggregation":"none","grain":"one Donation","modelingException":"a single-valued technical property is retained on purpose so the static layer is explicit in every projection","paymentMethodRole":"none"},"description":"Canonical layer label for this detail entity. Its only value is StaticSyntheticSnapshot, which is not a payment method or a time-series event type. The constant is a deliberate exception to the rule that a single-valued column carries no information: it is the declared boundary marker that keeps the static snapshot separable from the operational observation layer, so a query can never silently blend the two. Never filter it away, never group by it, and never present it as a lifecycle or approval state."}</fabric:semanticEnrichmentJson>
    <fabric:valueType>String</fabric:valueType>
  </rdf:Description>
