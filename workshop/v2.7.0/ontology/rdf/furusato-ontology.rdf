  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift__GiftSearchTerms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment>Pipe-delimited search-only text for resolving shortened or colloquial Gift wording. It contains the core GiftName, the English GiftNameEn, the Japanese CategoryName, and the English CategoryNameEn. Place-of-origin words often appear inside those name strings, but they are display text and not authoritative geography, so resolve catalog and recipient geography through MunicipalityCatalogsGift and DonationToMunicipality. Filter it with a case-insensitive substring match for every distinctive noun supplied by the user; never display, group, count, or treat it as Gift identity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift" />
    <rdfs:label>GiftSearchTerms</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
    <fabric:businessRole>search-only Gift resolver</fabric:businessRole>
    <fabric:defaultAggregation>none</fabric:defaultAggregation>
    <fabric:displayPolicy>never display, group, or aggregate</fabric:displayPolicy>
    <fabric:format>{GiftName} | {GiftNameEn} | {CategoryName} | {CategoryNameEn}</fabric:format>
    <fabric:grain>one value per Gift</fabric:grain>
    <fabric:language>ja-JP,en</fabric:language>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"196401923428015932","name":"GiftSearchTerms","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"search-only Gift resolver","defaultAggregation":"none","displayPolicy":"never display, group, or aggregate","format":"{GiftName} | {GiftNameEn} | {CategoryName} | {CategoryNameEn}","grain":"one value per Gift","language":"ja-JP,en","queryPattern":"FILTER lower(g.GiftSearchTerms) CONTAINS lower('&lt;distinctive token&gt;') for every supplied token","sensitivity":"Public-Synthetic-Catalog"},"description":"Pipe-delimited search-only text for resolving shortened or colloquial Gift wording. It contains the core GiftName, the English GiftNameEn, the Japanese CategoryName, and the English CategoryNameEn. Place-of-origin words often appear inside those name strings, but they are display text and not authoritative geography, so resolve catalog and recipient geography through MunicipalityCatalogsGift and DonationToMunicipality. Filter it with a case-insensitive substring match for every distinctive noun supplied by the user; never display, group, count, or treat it as Gift identity."},"valueType":"String"}</fabric:propertyDefinitionJson>
    <fabric:propertyId>196401923428015932</fabric:propertyId>
    <fabric:propertyKind>static</fabric:propertyKind>
    <fabric:queryPattern>FILTER lower(g.GiftSearchTerms) CONTAINS lower('&lt;distinctive token&gt;') for every supplied token</fabric:queryPattern>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"search-only Gift resolver","defaultAggregation":"none","displayPolicy":"never display, group, or aggregate","format":"{GiftName} | {GiftNameEn} | {CategoryName} | {CategoryNameEn}","grain":"one value per Gift","language":"ja-JP,en","queryPattern":"FILTER lower(g.GiftSearchTerms) CONTAINS lower('&lt;distinctive token&gt;') for every supplied token","sensitivity":"Public-Synthetic-Catalog"},"description":"Pipe-delimited search-only text for resolving shortened or colloquial Gift wording. It contains the core GiftName, the English GiftNameEn, the Japanese CategoryName, and the English CategoryNameEn. Place-of-origin words often appear inside those name strings, but they are display text and not authoritative geography, so resolve catalog and recipient geography through MunicipalityCatalogsGift and DonationToMunicipality. Filter it with a case-insensitive substring match for every distinctive noun supplied by the user; never display, group, count, or treat it as Gift identity."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public-Synthetic-Catalog</fabric:sensitivity>
    <fabric:valueType>String</fabric:valueType>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift__GiftStaticCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment>Authoritative pre-aggregated count of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift count; do not join Suppliers or recount Donation detail.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift" />
    <rdfs:label>GiftStaticCount</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#long" />
    <fabric:businessRole>gift snapshot metric</fabric:businessRole>
    <fabric:defaultAggregation>none</fabric:defaultAggregation>
    <fabric:grain>one Gift</fabric:grain>
    <fabric:measure>count of Donation</fabric:measure>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"770784031709312495","name":"GiftStaticCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"gift snapshot metric","defaultAggregation":"none","grain":"one Gift","measure":"count of Donation","queryPolicy":"select directly from the resolved Gift without traversing any relationship"},"description":"Authoritative pre-aggregated count of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift count; do not join Suppliers or recount Donation detail."},"valueType":"BigInt"}</fabric:propertyDefinitionJson>
    <fabric:propertyId>770784031709312495</fabric:propertyId>
    <fabric:propertyKind>static</fabric:propertyKind>
    <fabric:queryPolicy>select directly from the resolved Gift without traversing any relationship</fabric:queryPolicy>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"gift snapshot metric","defaultAggregation":"none","grain":"one Gift","measure":"count of Donation","queryPolicy":"select directly from the resolved Gift without traversing any relationship"},"description":"Authoritative pre-aggregated count of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift count; do not join Suppliers or recount Donation detail."}</fabric:semanticEnrichmentJson>
    <fabric:valueType>BigInt</fabric:valueType>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift__GiftStaticTotalYen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
