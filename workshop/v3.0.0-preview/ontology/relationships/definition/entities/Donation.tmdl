	/// Canonical layer label for this detail entity. Its only value is StaticSyntheticSnapshot, which is not a payment method or a time-series event type. The constant is a deliberate exception to the rule that a single-valued column carries no information: it is the declared boundary marker that keeps the static snapshot separable from the operational observation layer, so a query can never silently blend the two. Never filter it away, never group by it, and never present it as a lifecycle or approval state.
	property DonationDataLayer
		dataType: string
		lineageTag: 5e4fae1d-d340-5941-9ace-8a38e9ddc041
		annotation Furusato_boundaryRole = "static-versus-observation layer marker"
		annotation Furusato_businessRole = "data layer discriminator"
		annotation Furusato_canonicalValue = "StaticSyntheticSnapshot"
		annotation Furusato_constantByDesign = "true"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_grain = "one Donation"
		annotation Furusato_modelingException = "a single-valued technical property is retained on purpose so the static layer is explicit in every projection"
		annotation Furusato_paymentMethodRole = "none"

		backingConfiguration
			valueColumn: ot_donation.DonationDataLayer

