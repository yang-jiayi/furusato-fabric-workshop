  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donation__DonatedAtUtc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment>Canonical UTC timestamp of the static baseline Donation. Use it for exact sorting, filtering, minimum, maximum, and deterministic latest-record selection.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donation" />
    <rdfs:label>DonatedAtUtc</rdfs:label>
