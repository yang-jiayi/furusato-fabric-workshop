  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#FlowToRecipientPref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment>Connects a PrefectureDonationFlow row to the Donation-recipient Prefecture.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#PrefectureDonationFlow" />
    <rdfs:label>FlowToRecipientPref</rdfs:label>
    <rdfs:range rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Prefecture" />
    <fabric:aggregationGuard>flow rows are already aggregated at residence x recipient Prefecture grain</fabric:aggregationGuard>
    <fabric:businessRole>Donation-recipient destination of a pre-aggregated prefecture flow</fabric:businessRole>
    <fabric:cardinality>many-to-one, exactly one recipient Prefecture per PrefectureDonationFlow row</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"7285378347920053125","name":"FlowToRecipientPref","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"flow rows are already aggregated at residence x recipient Prefecture grain","businessRole":"Donation-recipient destination of a pre-aggregated prefecture flow","cardinality":"many-to-one, exactly one recipient Prefecture per PrefectureDonationFlow row","direction":"PrefectureDonationFlow -&gt; recipient Prefecture","geographyRole":"destination recipient","grain":"one edge per flow row","sensitivity":"Public","sourceParticipation":"mandatory - every PrefectureDonationFlow carries exactly one edge","targetParticipation":"optional - a Prefecture may have zero PrefectureDonationFlow rows"},"description":"Connects a PrefectureDonationFlow row to the Donation-recipient Prefecture."},"source":{"entityTypeId":"111782498358526"},"target":{"entityTypeId":"264514858427221"}}</fabric:definitionJson>
    <fabric:definitionPart>RelationshipTypes/7285378347920053125/definition.json</fabric:definitionPart>
    <fabric:direction>PrefectureDonationFlow -&gt; recipient Prefecture</fabric:direction>
    <fabric:geographyRole>destination recipient</fabric:geographyRole>
    <fabric:grain>one edge per flow row</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_ddb36817-4917-41f4-ab67-8cbb0f820cbb" />
    <fabric:relationshipTypeId>7285378347920053125</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"flow rows are already aggregated at residence x recipient Prefecture grain","businessRole":"Donation-recipient destination of a pre-aggregated prefecture flow","cardinality":"many-to-one, exactly one recipient Prefecture per PrefectureDonationFlow row","direction":"PrefectureDonationFlow -&gt; recipient Prefecture","geographyRole":"destination recipient","grain":"one edge per flow row","sensitivity":"Public","sourceParticipation":"mandatory - every PrefectureDonationFlow carries exactly one edge","targetParticipation":"optional - a Prefecture may have zero PrefectureDonationFlow rows"},"description":"Connects a PrefectureDonationFlow row to the Donation-recipient Prefecture."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public</fabric:sensitivity>
    <fabric:sourceParticipation>mandatory - every PrefectureDonationFlow carries exactly one edge</fabric:sourceParticipation>
    <fabric:targetParticipation>optional - a Prefecture may have zero PrefectureDonationFlow rows</fabric:targetParticipation>
