furusato:Municipality fabric:definitionJson "{\"$schema\":\"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json\",\"baseEntityTypeId\":null,\"displayNamePropertyId\":\"5318995285645577870\",\"entityIdParts\":[\"5318995285286504502\"],\"id\":\"57727254480397\",\"name\":\"Municipality\",\"namespace\":\"usertypes\",\"namespaceType\":\"Custom\",\"properties\":[{\"baseTypeNamespaceType\":null,\"id\":\"5318995285286504502\",\"name\":\"MunicipalityId\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"stable entity identifier\",\"defaultAggregation\":\"none\",\"format\":\"string ID\",\"grain\":\"one Municipality\"},\"description\":\"Stable identifier for one Municipality entity. Preserve leading zeros if present and use it as the relationship key; do not aggregate it.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5318995282168547313\",\"name\":\"MunicipalityName\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"Japanese label\",\"defaultAggregation\":\"none\",\"format\":\"Japanese text\",\"grain\":\"one value per Municipality\",\"language\":\"ja-JP\",\"sensitivity\":\"Public\"},\"description\":\"Japanese municipality name (自治体名／市区町村名) without a prefecture qualifier. Names are not globally unique, so include MunicipalityId or MunicipalityDisplayName when ambiguity is possible.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5318995285645577870\",\"name\":\"MunicipalityDisplayName\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"display label\",\"defaultAggregation\":\"none\",\"format\":\"{MunicipalityName} / {PrefectureName}\",\"grain\":\"one value per Municipality\",\"language\":\"ja-JP\",\"sensitivity\":\"Public\"},\"description\":\"Display-only composite label in the format {MunicipalityName} / {PrefectureName}. It does not contain MunicipalityId, so use MunicipalityId as the identity and this property only for human-readable output.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"161332579511618620\",\"name\":\"MunicipalityStaticCount\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"received snapshot metric\",\"defaultAggregation\":\"none\",\"grain\":\"one Municipality\",\"measure\":\"count of Donation\"},\"description\":\"Pre-aggregated count of static Donations received by this Municipality.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"179770367015274997\",\"name\":\"MunicipalityStaticTotalYen\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"received snapshot metric\",\"defaultAggregation\":\"none\",\"grain\":\"one Municipality\",\"unit\":\"JPY\"},\"description\":\"Pre-aggregated static Donation amount received by this Municipality in JPY.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"787769671224469935\",\"name\":\"MunicipalityAmountRank\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"received amount rank\",\"defaultAggregation\":\"none\",\"grain\":\"one Municipality\",\"rankMethod\":\"row_number\",\"rankPartition\":\"none (single global window)\",\"rankScope\":\"all Municipalities\",\"rankSort\":\"MunicipalityStaticTotalYen desc, MunicipalityId asc\",\"rankTieBreak\":\"MunicipalityId ascending\"},\"description\":\"Received-amount rank of this Municipality across all Municipalities. Deterministic row-number rank (row_number) over MunicipalityStaticTotalYen desc, MunicipalityId asc: equal amounts never share a rank because MunicipalityId breaks the tie ascending.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"168756737285027664\",\"name\":\"MunicipalityPrefAmountRank\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"received amount rank\",\"defaultAggregation\":\"none\",\"grain\":\"one Municipality\",\"rankMethod\":\"row_number\",\"rankPartition\":\"PrefectureId\",\"rankScope\":\"within containing Prefecture\",\"rankSort\":\"MunicipalityStaticTotalYen desc, MunicipalityId asc\",\"rankTieBreak\":\"MunicipalityId ascending\"},\"description\":\"Received-amount rank of this Municipality inside its containing Prefecture. Deterministic row-number rank (row_number) over MunicipalityStaticTotalYen desc, MunicipalityId asc within each PrefectureId: equal amounts never share a rank because MunicipalityId breaks the tie ascending.\"},\"valueType\":\"BigInt\"}],\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"recipient geography dimension\",\"factPolicy\":\"Donation is the transaction fact\",\"grain\":\"one entity per Japanese municipality\",\"sensitivity\":\"Public\",\"timeSeriesRole\":\"context key only\"},\"description\":\"Japanese municipality (自治体／市区町村) that may receive zero or more Donations. It also keys operational time-series observations; those observations are not Donation entities and have no Donor, Gift, or Supplier identity.\",\"synonyms\":[\"municipality\",\"municipalities\",\"recipient municipality\",\"donation destination\",\"local government\",\"local authority\",\"city\",\"town\",\"village\",\"ward\",\"自治体\",\"市区町村\",\"受入自治体\",\"寄付先自治体\",\"寄附先自治体\"]},\"timeseriesProperties\":[{\"baseTypeNamespaceType\":null,\"id\":\"5823284714213132117\",\"name\":\"IncomingDonationAmountYen\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"operational time-series measure\",\"deduplication\":\"none - raw ingested rows; duplicate EventIDs retained\",\"defaultAggregation\":\"SUM only within an explicitly requested time-series scope\",\"grain\":\"one ingested event observation for one Municipality\",\"numericAuthority\":\"Eventhouse curated view; this property is a modeled mirror\",\"sensitivity\":\"Synthetic-Transaction\",\"sourceTable\":\"DonationEvents (raw), not DonationObservationSummaryForAgent\",\"staticFactPolicy\":\"must not be combined with Donation entity counts or amounts\",\"timezone\":\"event timestamp DonatedAt is UTC\",\"unit\":\"JPY\"},\"description\":\"Donation amount observed in an operational Municipality time-series event. It binds to the raw ingested DonationEvents rows through DonatedAt and DonationAmountYen, so its values are raw observations: deduplication = none, and duplicate EventIDs are retained. It is measured in JPY but is not a static Donation entity property; never use it to increase Donation entity counts or to identify a Donor, Gift, Supplier, or DonationId. The Eventhouse remains the numeric authority for operational observation metrics; this property is a modeled mirror of them.\"},\"valueType\":\"BigInt\"}],\"untypedProperties\":[],\"visibility\":\"Visible\"}" .
