furusato:Donation fabric:definitionJson "{\"$schema\":\"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json\",\"baseEntityTypeId\":null,\"displayNamePropertyId\":\"5483655106008901287\",\"entityIdParts\":[\"5483655105060091170\"],\"id\":\"25626978028784\",\"name\":\"Donation\",\"namespace\":\"usertypes\",\"namespaceType\":\"Custom\",\"properties\":[{\"baseTypeNamespaceType\":null,\"id\":\"5483655105060091170\",\"name\":\"DonationId\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"stable transaction identifier\",\"defaultAggregation\":\"none\",\"format\":\"integer ID\",\"grain\":\"one static Donation\"},\"description\":\"Stable numeric identifier for one static Donation transaction. When a user says 寄付ID or Donation ID followed by a number, filter this property for exact identity; never reinterpret that number as DonationAmountYen. It is the transaction key and must not be used as a grouping dimension for an overall aggregate.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655106008901287\",\"name\":\"DonationDisplayName\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"display label\",\"defaultAggregation\":\"none\",\"format\":\"Donation {DonationId}\",\"grain\":\"one value per Donation\",\"language\":\"en\",\"sensitivity\":\"Synthetic-Transaction\"},\"description\":\"Display-only label in the format Donation followed by DonationId. Use DonationId for identity.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655104000010925\",\"name\":\"DonationAmountYen\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"additive fact measure\",\"defaultAggregation\":\"SUM\",\"format\":\"whole-yen integer\",\"grain\":\"one value per Donation\",\"sensitivity\":\"Synthetic-Transaction\",\"unit\":\"JPY\"},\"description\":\"Completed donation amount (寄付金額／寄附金額／納税額) in whole Japanese yen for exactly one static Donation. SUM this property for donation totals and never sum IDs or Municipality time-series observations into the same result.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655104623403417\",\"name\":\"DonatedAtUtc\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"canonical transaction timestamp\",\"defaultAggregation\":\"MIN or MAX only\",\"format\":\"DateTime\",\"grain\":\"one value per Donation\",\"sensitivity\":\"Synthetic-Transaction\",\"timezone\":\"UTC\"},\"description\":\"Canonical UTC timestamp of the static baseline Donation. Use it for exact sorting, filtering, minimum, maximum, and deterministic latest-record selection.\"},\"valueType\":\"DateTime\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655103361864781\",\"name\":\"DonatedAtJstText\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"localized display timestamp\",\"defaultAggregation\":\"none\",\"format\":\"yyyy-MM-dd HH:mm:ss JST\",\"grain\":\"one value per Donation\",\"sensitivity\":\"Synthetic-Transaction\",\"timezone\":\"Asia/Tokyo (+09:00)\"},\"description\":\"Display-only representation of DonatedAtUtc in Japan Standard Time (日本時間), formatted as yyyy-MM-dd HH:mm:ss followed by the literal suffix JST. Do not use this string for chronological sorting when DonatedAtUtc is available.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655102375651886\",\"name\":\"DonationDateJst\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"local calendar date\",\"defaultAggregation\":\"none\",\"format\":\"yyyy-MM-dd\",\"grain\":\"one value per Donation\",\"sensitivity\":\"Synthetic-Transaction\",\"timezone\":\"Asia/Tokyo\",\"unit\":\"day\"},\"description\":\"Japan Standard Time calendar date of the Donation (寄付日／寄附日). Use it for local-day filtering and grouping, not for exact timestamp ordering.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655102515804864\",\"name\":\"DonationYearMonthJst\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"local calendar month\",\"defaultAggregation\":\"none\",\"format\":\"yyyy-MM\",\"grain\":\"one value per Donation\",\"sensitivity\":\"Synthetic-Transaction\",\"timezone\":\"Asia/Tokyo\",\"unit\":\"month\"},\"description\":\"Japan Standard Time calendar year and month of the Donation (寄付年月／寄附年月). Use it for local-month filtering and grouping. Normalize an unambiguous Japanese two-digit Gregorian year such as 25年 to 2025 before matching the stored yyyy-MM value.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"109526130664541126\",\"name\":\"DonationYearMonthJaShort\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"Japanese short local calendar month\",\"defaultAggregation\":\"none\",\"format\":\"yyyy年M月\",\"grain\":\"one value per Donation\",\"sensitivity\":\"Synthetic-Transaction\",\"timezone\":\"Asia/Tokyo\",\"unit\":\"month\"},\"description\":\"Japanese short Gregorian year-month label for the Donation, formatted yyyy年M月, such as 2025年1月. Use it only when the user supplies that short Japanese month wording; DonationYearMonthJst remains the canonical yyyy-MM calendar key.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655103519169649\",\"name\":\"DonationPaymentMethod\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"Japanese or brand categorical attribute\",\"defaultAggregation\":\"none\",\"format\":\"controlled text, 4 values\",\"grain\":\"one value per Donation\",\"language\":\"ja-JP and brand names\",\"sensitivity\":\"Synthetic-Transaction\"},\"description\":\"Stored payment method, payment channel, checkout channel, or tender label (支払方法／決済方法／決済手段) for the completed Donation. It is a controlled Japanese-or-brand label and must not be interpreted as a Supplier.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5483655103100366717\",\"name\":\"DonationPaymentMethodEn\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"canonical English categorical attribute\",\"defaultAggregation\":\"none\",\"format\":\"controlled text, 4 values\",\"grain\":\"one value per Donation\",\"language\":\"en\",\"sensitivity\":\"Synthetic-Transaction\"},\"description\":\"Canonical English payment-method label for DonationPaymentMethod. Use it for English filtering and grouping; return both labels when the user asks for a translation.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"177982238026863913\",\"name\":\"DonationDataLayer\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"boundaryRole\":\"static-versus-observation layer marker\",\"businessRole\":\"data layer discriminator\",\"canonicalValue\":\"StaticSyntheticSnapshot\",\"constantByDesign\":\"true\",\"defaultAggregation\":\"none\",\"grain\":\"one Donation\",\"modelingException\":\"a single-valued technical property is retained on purpose so the static layer is explicit in every projection\",\"paymentMethodRole\":\"none\"},\"description\":\"Canonical layer label for this detail entity. Its only value is StaticSyntheticSnapshot, which is not a payment method or a time-series event type. The constant is a deliberate exception to the rule that a single-valued column carries no information: it is the declared boundary marker that keeps the static snapshot separable from the operational observation layer, so a query can never silently blend the two. Never filter it away, never group by it, and never present it as a lifecycle or approval state.\"},\"valueType\":\"String\"}],\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"transaction fact\",\"currency\":\"JPY\",\"factPolicy\":\"only source for transaction counts and donation amounts\",\"grain\":\"one static baseline donation\",\"sensitivity\":\"Synthetic-Transaction\",\"timeSeriesPolicy\":\"Municipality time-series observations are excluded\"},\"description\":\"Synthetic static baseline hometown-tax Donation row (ふるさと納税の寄付／寄附) and the only static fact grain for transaction counts and JPY amounts. It is an independent snapshot, not an approved, promoted, deduplicated, or finalized form of an Eventhouse observation. Each entity links to exactly one Donor, one recipient Municipality, and one selected Gift option in this dataset.\",\"synonyms\":[\"donation\",\"donations\",\"contribution\",\"contributions\",\"donation record\",\"contribution record\",\"donation transaction\",\"donation order\",\"completed donation\",\"hometown tax donation\",\"Furusato Nozei donation\",\"Furusato tax contribution\",\"寄付\",\"寄附\",\"寄付申込\",\"寄附申込\",\"ふるさと納税\"]},\"timeseriesProperties\":[],\"untypedProperties\":[],\"visibility\":\"Visible\"}" .
