    <fabric:defaultAggregation>none</fabric:defaultAggregation>
    <fabric:format>free text</fabric:format>
    <fabric:grain>one value per Gift</fabric:grain>
    <fabric:language>ja-JP</fabric:language>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"5416054541651706320","name":"GiftNotes","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"descriptive text","defaultAggregation":"none","format":"free text","grain":"one value per Gift","language":"ja-JP","sensitivity":"Public-Synthetic-Catalog"},"description":"Japanese free-text note, notes, remarks, or description for the return-gift option (備考／注意事項／説明). Notes are descriptive only and do not define Supplier, recipient geography, category, or monetary amount."},"valueType":"String"}</fabric:propertyDefinitionJson>
