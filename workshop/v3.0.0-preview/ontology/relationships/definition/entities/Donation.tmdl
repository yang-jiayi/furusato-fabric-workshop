		annotation Furusato_grain = "one value per Donation"
		annotation Furusato_sensitivity = "Synthetic-Transaction"
		annotation Furusato_timezone = "UTC"

		backingConfiguration
			valueColumn: ot_donation.DonatedAtUtc

	/// Display-only representation of DonatedAtUtc in Japan Standard Time (日本時間), formatted as yyyy-MM-dd HH:mm:ss followed by the literal suffix JST. Do not use this string for chronological sorting when DonatedAtUtc is available.
	property DonatedAtJstText
		dataType: string
		lineageTag: 064d9584-5e9b-547b-bb0e-5ec636ef7e65
		annotation Furusato_businessRole = "localized display timestamp"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_format = "yyyy-MM-dd HH:mm:ss JST"
		annotation Furusato_grain = "one value per Donation"
