    <fabric:aggregationGuard>use DonorMadeDonation before aggregating Donation facts</fabric:aggregationGuard>
    <fabric:businessRole>donor residence geography</fabric:businessRole>
    <fabric:cardinality>many-to-one, exactly one Prefecture per Donor</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"5534818874484272204","name":"DonorLivesInPrefecture","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"use DonorMadeDonation before aggregating Donation facts","businessRole":"donor residence geography","cardinality":"many-to-one, exactly one Prefecture per Donor","direction":"Donor -&gt; Prefecture","grain":"one edge per Donor","sensitivity":"Synthetic-Personal","sourceParticipation":"mandatory - every Donor carries exactly one edge","targetParticipation":"optional - a Prefecture may have zero Donor rows"},"description":"Connects a synthetic Donor to the Prefecture of donor residence. This relationship defines donor-origin geography only and must never be treated as the Donation recipient."},"source":{"entityTypeId":"244579893085159"},"target":{"entityTypeId":"264514858427221"}}</fabric:definitionJson>
    <fabric:definitionPart>RelationshipTypes/5534818874484272204/definition.json</fabric:definitionPart>
    <fabric:direction>Donor -&gt; Prefecture</fabric:direction>
    <fabric:grain>one edge per Donor</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_1500f62f-ee77-439b-ab6f-faa097d71535" />
    <fabric:relationshipTypeId>5534818874484272204</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"use DonorMadeDonation before aggregating Donation facts","businessRole":"donor residence geography","cardinality":"many-to-one, exactly one Prefecture per Donor","direction":"Donor -&gt; Prefecture","grain":"one edge per Donor","sensitivity":"Synthetic-Personal","sourceParticipation":"mandatory - every Donor carries exactly one edge","targetParticipation":"optional - a Prefecture may have zero Donor rows"},"description":"Connects a synthetic Donor to the Prefecture of donor residence. This relationship defines donor-origin geography only and must never be treated as the Donation recipient."}</fabric:semanticEnrichmentJson>
