/// Synthetic static baseline hometown-tax Donation row (ふるさと納税の寄付／寄附) and the only static fact grain for transaction counts and JPY amounts. It is an independent snapshot, not an approved, promoted, deduplicated, or finalized form of an Eventhouse observation. Each entity links to exactly one Donor, one recipient Municipality, and one selected Gift option in this dataset.
entity Donation
	lineageTag: 60b60851-200a-5115-a6a2-e3724298f2a0
	backingTable: ot_donation
	keyProperty: DonationId
	synonym donation
	synonym donations
	synonym contribution
	synonym contributions
	synonym 'donation record'
	synonym 'contribution record'
	synonym 'donation transaction'
	synonym 'donation order'
	synonym 'completed donation'
	synonym 'hometown tax donation'
	synonym 'Furusato Nozei donation'
	synonym 'Furusato tax contribution'
	synonym '寄付'
	synonym '寄附'
	synonym '寄付申込'
	synonym '寄附申込'
	synonym 'ふるさと納税'
	annotation Furusato_businessRole = "transaction fact"
	annotation Furusato_currency = "JPY"
	annotation Furusato_factPolicy = "only source for transaction counts and donation amounts"
	annotation Furusato_grain = "one static baseline donation"
	annotation Furusato_sensitivity = "Synthetic-Transaction"
	annotation Furusato_timeSeriesPolicy = "Municipality time-series observations are excluded"

	/// Stable numeric identifier for one static Donation transaction. When a user says 寄付ID or Donation ID followed by a number, filter this property for exact identity; never reinterpret that number as DonationAmountYen. It is the transaction key and must not be used as a grouping dimension for an overall aggregate.
	property DonationId
		dataType: int64
		lineageTag: 087f485f-5256-5643-a6ff-1e3dba761d93
		annotation Furusato_businessRole = "stable transaction identifier"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_format = "integer ID"
		annotation Furusato_grain = "one static Donation"

		backingConfiguration
			valueColumn: ot_donation.DonationId

	/// Display-only label in the format Donation followed by DonationId. Use DonationId for identity.
	property DonationDisplayName
		dataType: string
		lineageTag: 6c547580-1feb-5b3d-b049-307769d47613
		annotation Furusato_businessRole = "display label"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_format = "Donation {DonationId}"
		annotation Furusato_grain = "one value per Donation"
		annotation Furusato_language = "en"
		annotation Furusato_sensitivity = "Synthetic-Transaction"

		backingConfiguration
			valueColumn: ot_donation.DonationDisplayName

	/// Completed donation amount (寄付金額／寄附金額／納税額) in whole Japanese yen for exactly one static Donation. SUM this property for donation totals and never sum IDs or Municipality time-series observations into the same result.
	property DonationAmountYen
		dataType: int64
		lineageTag: c3440073-ca19-5043-97fc-5c0151c24760
		annotation Furusato_businessRole = "additive fact measure"
		annotation Furusato_defaultAggregation = "SUM"
		annotation Furusato_format = "whole-yen integer"
		annotation Furusato_grain = "one value per Donation"
		annotation Furusato_sensitivity = "Synthetic-Transaction"
		annotation Furusato_unit = "JPY"

		backingConfiguration
			valueColumn: ot_donation.DonationAmountYen

	/// Canonical UTC timestamp of the static baseline Donation. Use it for exact sorting, filtering, minimum, maximum, and deterministic latest-record selection.
	property DonatedAtUtc
		dataType: dateTime
		lineageTag: a788dd16-5aaf-5665-9dc8-ac5b3c641c97
		annotation Furusato_businessRole = "canonical transaction timestamp"
