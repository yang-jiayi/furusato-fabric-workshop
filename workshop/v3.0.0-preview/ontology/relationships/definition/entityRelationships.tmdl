	annotation Furusato_direction = "Municipality -> MunicipalityCategoryMetric"
	annotation Furusato_grain = "one edge per metric row"
	annotation Furusato_sensitivity = "Public"
	annotation Furusato_sourceParticipation = "optional - 10 Municipalities have no metric row"
	annotation Furusato_targetParticipation = "mandatory - every metric row has exactly one Municipality"

	backingConfiguration
		relationship: rel_MunHasCategoryMetric

