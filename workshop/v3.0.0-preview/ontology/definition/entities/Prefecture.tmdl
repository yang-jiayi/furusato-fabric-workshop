		annotation Furusato_language = "en"
		annotation Furusato_sensitivity = "Public"

		backingConfiguration
			valueColumn: ot_prefecture.PrefectureNameEn

	/// Pre-aggregated count of static Donations received by municipalities in this Prefecture.
	property PrefReceivedStaticCount
		dataType: int64
		lineageTag: 0d7c2533-e3e5-5ba0-9fb5-da192adb4f35
		annotation Furusato_businessRole = "received snapshot metric"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_grain = "one Prefecture"
		annotation Furusato_measure = "count of Donation"
		annotation Furusato_snapshotScope = "current static Donation only"

		backingConfiguration
			valueColumn: ot_prefecture.PrefReceivedStaticCount

	/// Pre-aggregated JPY amount received by municipalities in this Prefecture.
	property PrefReceivedTotalYen
		dataType: int64
		lineageTag: 57ff05d9-8abf-5a15-b2d2-b8c7f44940b8
		annotation Furusato_businessRole = "received snapshot metric"
