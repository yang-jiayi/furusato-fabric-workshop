      "title": "Rule-grounded interpretation before and after",
      "roles": {"answer": "native_response", "trace": "execution_trace", "source": "source_query", "comparison": "comparison"},
      "checks": ["same_frozen_prompt_data_identity", "fresh_conversation", "factual_source_truth", "no_unperformed_action_claim", "all_repeats_retained"],
      "required_items": ["ontology"]
    },
    {
      "id": "NAMESPACE01", "category": "structural", "critical": true,
      "title": "Namespaces, inheritance, shared properties and graph eligibility",
      "roles": {"definition": "definition", "screen": "ui_capture", "eligibility": "capability_probe"},
      "checks": ["qualified_name_resolution", "single_parent_is_a_not_composition", "shared_property_identity_and_type", "inherited_keys", "graph_eligibility_per_entity"],
      "required_items": ["ontology"]
    },
    {
      "id": "COPILOT01", "category": "structural", "critical": true,
      "title": "Plan, validation, preview, Act and structural readback",
      "roles": {"plan": "native_response", "preview": "ui_capture", "before": "definition", "after": "definition", "act": "operation_receipt"},
