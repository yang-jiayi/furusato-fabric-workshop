/// Japanese prefecture (都道府県) used in two separate geography paths: recipient geography through Municipality and donor-residence geography through Donor. It is a reference dimension, not a Donation fact grain.
entity Prefecture
	lineageTag: fe67e9ad-95b1-5fe5-88e0-75f1a24b6d5f
	backingTable: ot_prefecture
	keyProperty: PrefectureId
	synonym prefecture
	synonym prefectures
	synonym 'Japanese prefecture'
	synonym 'recipient prefecture'
	synonym 'donor residence prefecture'
	synonym '都道府県'
	synonym '都府県'
	annotation Furusato_businessRole = "reference geography dimension"
	annotation Furusato_geographyRoles = "recipient prefecture and donor-residence prefecture"
	annotation Furusato_grain = "one entity per Japanese prefecture"
	annotation Furusato_language = "ja-JP,en"
	annotation Furusato_sensitivity = "Public"

	/// Stable numeric identifier for one Japanese Prefecture entity. Use it to disambiguate names and as the relationship key; do not aggregate it. If the user explicitly asks for a 都道府県 or Prefecture result, keep this grain and never substitute a Municipality.
	property PrefectureId
		dataType: int64
		lineageTag: 31072d74-302a-558b-a29a-a288d6b7ab62
		annotation Furusato_businessRole = "stable entity identifier"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_format = "integer ID"
		annotation Furusato_grain = "one Prefecture"

		backingConfiguration
			valueColumn: ot_prefecture.PrefectureId

	/// Official Japanese display label of the prefecture (都道府県名). Preserve the exact stored Japanese text in output.
	property PrefectureName
		dataType: string
		lineageTag: 79d95df8-de4f-5422-868c-3fdc681d939f
		annotation Furusato_businessRole = "Japanese label"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_format = "Japanese text"
		annotation Furusato_grain = "one value per Prefecture"
		annotation Furusato_language = "ja-JP"
		annotation Furusato_sensitivity = "Public"

		backingConfiguration
			valueColumn: ot_prefecture.PrefectureName

	/// Canonical English label of the prefecture. Use it for English lookup and display; PrefectureId remains the identity.
	property PrefectureNameEn
		dataType: string
		lineageTag: 81f54efc-fc66-57cb-b9c8-6bf43dae67e9
		annotation Furusato_businessRole = "English label"
		annotation Furusato_defaultAggregation = "none"
		annotation Furusato_format = "English text"
