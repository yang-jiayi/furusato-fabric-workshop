    <fabric:defaultAggregation>none</fabric:defaultAggregation>
    <fabric:format>string ID</fabric:format>
    <fabric:grain>one residence Prefecture x recipient Prefecture pair</fabric:grain>
    <fabric:keyAmbiguity>the same NN-NN text may exist in another metric entity type; qualify by entity type</fabric:keyAmbiguity>
    <fabric:keyEncoding>{ResidencePrefectureId:02}-{RecipientPrefectureId:02}</fabric:keyEncoding>
    <fabric:keyExample>13-01 = residence Prefecture 13 to recipient Prefecture 01</fabric:keyExample>
    <fabric:keyPosition rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</fabric:keyPosition>
