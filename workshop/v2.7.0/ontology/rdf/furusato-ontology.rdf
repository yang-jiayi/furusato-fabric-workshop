    <fabric:propertyKind>static</fabric:propertyKind>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"canonical transaction timestamp","defaultAggregation":"MIN or MAX only","format":"DateTime","grain":"one value per Donation","sensitivity":"Synthetic-Transaction","timezone":"UTC"},"description":"Canonical UTC timestamp of the static baseline Donation. Use it for exact sorting, filtering, minimum, maximum, and deterministic latest-record selection."}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Synthetic-Transaction</fabric:sensitivity>
    <fabric:timezone>UTC</fabric:timezone>
    <fabric:valueType>DateTime</fabric:valueType>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donation__DonationAmountYen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment>Completed donation amount (寄付金額／寄附金額／納税額) in whole Japanese yen for exactly one static Donation. SUM this property for donation totals and never sum IDs or Municipality time-series observations into the same result.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donation" />
    <rdfs:label>DonationAmountYen</rdfs:label>
