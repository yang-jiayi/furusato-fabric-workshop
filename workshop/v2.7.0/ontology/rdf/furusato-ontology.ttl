furusato:MunicipalityCatalogsGift rdf:type owl:ObjectProperty .
furusato:MunicipalityCatalogsGift rdfs:comment "Connects a Municipality to each Gift registered in that Municipality's Workshop catalog. This is catalog geography, not Donation recipient geography, Supplier location, fulfillment location, or shipping origin. In this synthetic dataset every Donation happens to select a Gift catalogued by its own recipient Municipality, so a forbidden count taken through this edge can coincidentally return the same number as the correct DonationToMunicipality count. That coincidence is a property of the sample data, not of the model: the rule stays, because real catalogues diverge and the two paths answer different questions." .
furusato:MunicipalityCatalogsGift rdfs:domain furusato:Municipality .
furusato:MunicipalityCatalogsGift rdfs:label "MunicipalityCatalogsGift" .
furusato:MunicipalityCatalogsGift rdfs:range furusato:Gift .
furusato:MunicipalityCatalogsGift fabric:aggregationGuard "never count or sum Donation facts through this relationship; use DonationToMunicipality for received-by geography" .
furusato:MunicipalityCatalogsGift fabric:businessRole "gift catalog association" .
furusato:MunicipalityCatalogsGift fabric:cardinality "one-to-many from Municipality, exactly one catalog Municipality per Gift" .
furusato:MunicipalityCatalogsGift fabric:dataCoincidenceWarning "in this dataset the forbidden catalog path can return the same total as the correct recipient path; the guard protects future divergence, not this sample" .
furusato:MunicipalityCatalogsGift fabric:definitionJson "{\"$schema\":\"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json\",\"id\":\"7242420920535939500\",\"name\":\"MunicipalityCatalogsGift\",\"namespace\":\"usertypes\",\"namespaceType\":\"Custom\",\"semanticEnrichment\":{\"customAttributes\":{\"aggregationGuard\":\"never count or sum Donation facts through this relationship; use DonationToMunicipality for received-by geography\",\"businessRole\":\"gift catalog association\",\"cardinality\":\"one-to-many from Municipality, exactly one catalog Municipality per Gift\",\"dataCoincidenceWarning\":\"in this dataset the forbidden catalog path can return the same total as the correct recipient path; the guard protects future divergence, not this sample\",\"direction\":\"Municipality -> Gift\",\"grain\":\"one edge per Gift\",\"sensitivity\":\"Public-Synthetic-Catalog\",\"sourceParticipation\":\"mandatory - every one of the 1,741 Municipalities catalogs at least one Gift\",\"targetParticipation\":\"mandatory - every Gift has exactly one catalog Municipality\"},\"description\":\"Connects a Municipality to each Gift registered in that Municipality's Workshop catalog. This is catalog geography, not Donation recipient geography, Supplier location, fulfillment location, or shipping origin. In this synthetic dataset every Donation happens to select a Gift catalogued by its own recipient Municipality, so a forbidden count taken through this edge can coincidentally return the same number as the correct DonationToMunicipality count. That coincidence is a property of the sample data, not of the model: the rule stays, because real catalogues diverge and the two paths answer different questions.\"},\"source\":{\"entityTypeId\":\"57727254480397\"},\"target\":{\"entityTypeId\":\"21065477330866\"}}" .
