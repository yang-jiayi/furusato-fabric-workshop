      "required_items": ["copilot_lab"]
    },
    {
      "id": "COPILOT02", "category": "ai", "critical": true,
      "title": "Factual Copilot answers, separate from structural success",
      "roles": {"answer": "native_response", "trace": "execution_trace", "source": "source_query"},
      "checks": ["frozen_prompt_and_fresh_conversation", "executed_source_query", "numeric_grain_identity_truth", "no_plan_as_factual_proof", "all_repeats_retained"],
      "required_items": ["ontology"]
    },
    {
