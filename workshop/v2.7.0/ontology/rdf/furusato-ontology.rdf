    <fabric:defaultAggregation>none</fabric:defaultAggregation>
    <fabric:grain>one Gift</fabric:grain>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"562907930706153922","name":"GiftStaticTotalYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"gift snapshot metric","defaultAggregation":"none","grain":"one Gift","queryPolicy":"select directly from the resolved Gift without traversing any relationship","unit":"JPY"},"description":"Authoritative pre-aggregated JPY amount of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift total; do not join Suppliers or use SUM(DISTINCT DonationAmountYen)."},"valueType":"BigInt"}</fabric:propertyDefinitionJson>
    <fabric:propertyId>562907930706153922</fabric:propertyId>
    <fabric:propertyKind>static</fabric:propertyKind>
    <fabric:queryPolicy>select directly from the resolved Gift without traversing any relationship</fabric:queryPolicy>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"gift snapshot metric","defaultAggregation":"none","grain":"one Gift","queryPolicy":"select directly from the resolved Gift without traversing any relationship","unit":"JPY"},"description":"Authoritative pre-aggregated JPY amount of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift total; do not join Suppliers or use SUM(DISTINCT DonationAmountYen)."}</fabric:semanticEnrichmentJson>
    <fabric:unit>JPY</fabric:unit>
