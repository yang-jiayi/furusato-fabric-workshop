	column PrefDonationFlowId
		dataType: string
		sourceColumn: PrefDonationFlowId

	column PrefFlowStaticCount
		dataType: int64
		sourceColumn: PrefFlowStaticCount

	column PrefFlowTotalYen
		dataType: int64
		sourceColumn: PrefFlowTotalYen

	column PrefFlowOriginRank
		dataType: int64
		sourceColumn: PrefFlowOriginRank

	column PrefFlowDestinationRank
		dataType: int64
		sourceColumn: PrefFlowDestinationRank

	column ResidencePrefectureId
		dataType: int64
		sourceColumn: ResidencePrefectureId

	column RecipientPrefectureId
