    <fabric:businessRole>canonical transaction timestamp</fabric:businessRole>
    <fabric:defaultAggregation>MIN or MAX only</fabric:defaultAggregation>
    <fabric:format>DateTime</fabric:format>
    <fabric:grain>one value per Donation</fabric:grain>
    <fabric:propertyDefinitionJson>{"baseTypeNamespaceType":null,"id":"5483655104623403417","name":"DonatedAtUtc","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"canonical transaction timestamp","defaultAggregation":"MIN or MAX only","format":"DateTime","grain":"one value per Donation","sensitivity":"Synthetic-Transaction","timezone":"UTC"},"description":"Canonical UTC timestamp of the static baseline Donation. Use it for exact sorting, filtering, minimum, maximum, and deterministic latest-record selection."},"valueType":"DateTime"}</fabric:propertyDefinitionJson>
