furusato:SupplierInPrefecture rdf:type owl:ObjectProperty .
furusato:SupplierInPrefecture rdfs:comment "Connects a synthetic Supplier to its registered Prefecture. Registered Supplier location is neither donor residence, Donation recipient geography, fulfillment location, service location, nor shipping origin." .
furusato:SupplierInPrefecture rdfs:domain furusato:Supplier .
furusato:SupplierInPrefecture rdfs:label "SupplierInPrefecture" .
furusato:SupplierInPrefecture rdfs:range furusato:Prefecture .
furusato:SupplierInPrefecture fabric:aggregationGuard "do not infer Donation recipient from Supplier location" .
furusato:SupplierInPrefecture fabric:businessRole "supplier base geography" .
furusato:SupplierInPrefecture fabric:cardinality "many-to-one, exactly one Prefecture per Supplier" .
furusato:SupplierInPrefecture fabric:definitionJson "{\"$schema\":\"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json\",\"id\":\"5538623819003650898\",\"name\":\"SupplierInPrefecture\",\"namespace\":\"usertypes\",\"namespaceType\":\"Custom\",\"semanticEnrichment\":{\"customAttributes\":{\"aggregationGuard\":\"do not infer Donation recipient from Supplier location\",\"businessRole\":\"supplier base geography\",\"cardinality\":\"many-to-one, exactly one Prefecture per Supplier\",\"direction\":\"Supplier -> Prefecture\",\"grain\":\"one edge per Supplier\",\"sensitivity\":\"Synthetic-Organization\",\"sourceParticipation\":\"mandatory - every Supplier carries exactly one edge\",\"targetParticipation\":\"optional - a Prefecture may have zero Supplier rows\"},\"description\":\"Connects a synthetic Supplier to its registered Prefecture. Registered Supplier location is neither donor residence, Donation recipient geography, fulfillment location, service location, nor shipping origin.\"},\"source\":{\"entityTypeId\":\"193544498857107\"},\"target\":{\"entityTypeId\":\"264514858427221\"}}" .
