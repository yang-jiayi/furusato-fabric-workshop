    <fabric:aggregationGuard>flow rows are already aggregated at residence x recipient Prefecture grain</fabric:aggregationGuard>
    <fabric:businessRole>donor-residence origin of a pre-aggregated prefecture flow</fabric:businessRole>
    <fabric:cardinality>one-to-many from Prefecture, exactly one residence Prefecture per PrefectureDonationFlow row</fabric:cardinality>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/relationshipType/1.0.0/schema.json","id":"7265812375370015816","name":"ResidencePrefHasFlow","namespace":"usertypes","namespaceType":"Custom","semanticEnrichment":{"customAttributes":{"aggregationGuard":"flow rows are already aggregated at residence x recipient Prefecture grain","businessRole":"donor-residence origin of a pre-aggregated prefecture flow","cardinality":"one-to-many from Prefecture, exactly one residence Prefecture per PrefectureDonationFlow row","direction":"residence Prefecture -&gt; PrefectureDonationFlow","geographyRole":"origin donor residence","grain":"one edge per flow row","sensitivity":"Public","sourceParticipation":"mandatory - every one of the 47 Prefectures originates at least one flow row","targetParticipation":"mandatory - every flow row has exactly one residence Prefecture"},"description":"Connects the Donor-residence Prefecture to an origin-destination PrefectureDonationFlow row."},"source":{"entityTypeId":"264514858427221"},"target":{"entityTypeId":"111782498358526"}}</fabric:definitionJson>
