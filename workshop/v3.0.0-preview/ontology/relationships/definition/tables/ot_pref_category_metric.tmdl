table ot_pref_category_metric
	lineageTag: 8d536ec8-c4f3-53a9-bb1a-66123efc1db8

	column PrefCategoryMetricId
		dataType: string
		sourceColumn: PrefCategoryMetricId

	column PrefCategoryStaticCount
		dataType: int64
		sourceColumn: PrefCategoryStaticCount

	column PrefCategoryTotalYen
		dataType: int64
		sourceColumn: PrefCategoryTotalYen

	column PrefCategoryAmountRank
		dataType: int64
		sourceColumn: PrefCategoryAmountRank

	column PrefectureId
		dataType: int64
		sourceColumn: PrefectureId

	column CategoryId
		dataType: int64
