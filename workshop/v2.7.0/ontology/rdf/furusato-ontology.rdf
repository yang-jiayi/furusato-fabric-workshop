    <fabric:hasDataBinding rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#binding_38af81f7-b6dc-4c04-b3af-c17e05283a57" />
    <fabric:keyProperty rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Supplier__SupplierId" />
    <fabric:locationRole>supplier base prefecture</fabric:locationRole>
    <fabric:metricPolicy>supplier allocation is not defined</fabric:metricPolicy>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"provider dimension","grain":"one synthetic supplier","locationRole":"supplier base prefecture","metricPolicy":"supplier allocation is not defined","sensitivity":"Synthetic-Organization"},"description":"Synthetic workshop business that may provide zero or more return-gift options (返礼品提供事業者). It is neither the Donation recipient nor a Donor; location is defined by SupplierInPrefecture.","synonyms":["supplier","suppliers","vendor","vendors","provider","providers","merchant","local business","return-gift provider","gift supplier","事業者","提供事業者","返礼品事業者","ベンダー","加盟店"]}</fabric:semanticEnrichmentJson>
