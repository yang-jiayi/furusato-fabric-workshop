furusato:GiftCategory fabric:definitionJson "{\"$schema\":\"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json\",\"baseEntityTypeId\":null,\"displayNamePropertyId\":\"5394698401700544536\",\"entityIdParts\":[\"5394698403364015417\"],\"id\":\"135818208486705\",\"name\":\"GiftCategory\",\"namespace\":\"usertypes\",\"namespaceType\":\"Custom\",\"properties\":[{\"baseTypeNamespaceType\":null,\"id\":\"5394698403364015417\",\"name\":\"CategoryId\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"stable entity identifier\",\"defaultAggregation\":\"none\",\"format\":\"integer ID\",\"grain\":\"one GiftCategory\"},\"description\":\"Stable numeric identifier for one GiftCategory entity. Use it with the stored category labels and never sum or average it.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"5394698401700544536\",\"name\":\"CategoryName\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"Japanese controlled label\",\"defaultAggregation\":\"none\",\"format\":\"controlled text, 30 values\",\"grain\":\"one value per GiftCategory\",\"language\":\"ja-JP\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Canonical Japanese return-gift category label (返礼品カテゴリ／返礼品分類). Category metrics must be calculated from Donation, not from this label.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5394698404119989434\",\"name\":\"CategoryNameEn\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"canonical English label\",\"defaultAggregation\":\"none\",\"format\":\"controlled text, 30 values\",\"grain\":\"one value per GiftCategory\",\"language\":\"en\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Canonical English return-gift category label paired one-to-one with CategoryName. Use it for English filtering, grouping, and display; CategoryId remains the identity.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"5394698403117272042\",\"name\":\"CategorySearchTerms\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"search-only alias index\",\"displayPolicy\":\"never display, group, or aggregate\",\"format\":\"{CategoryName} | {CategoryNameEn} | gift category\",\"grain\":\"one value per GiftCategory\",\"language\":\"ja-JP,en\",\"queryPattern\":\"FILTER lower(c.CategorySearchTerms) CONTAINS lower('<alias>')\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Pipe-delimited alias text holding the Japanese CategoryName, the English CategoryNameEn, and the literal marker gift category. Use it only to resolve colloquial return-gift category wording such as 海鮮系, 魚介, or seafood with a case-insensitive substring match. If CategoryName does not match, query this alias index before claiming no category data. Never display, group, count, or treat this property as the category identity.\"},\"valueType\":\"String\"},{\"baseTypeNamespaceType\":null,\"id\":\"721526931524255498\",\"name\":\"CategoryStaticCount\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"category snapshot metric\",\"defaultAggregation\":\"none\",\"grain\":\"one GiftCategory\",\"measure\":\"count of Donation\"},\"description\":\"Pre-aggregated static Donation count for this GiftCategory across the full snapshot.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"200890417511184799\",\"name\":\"CategoryStaticTotalYen\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"category snapshot metric\",\"defaultAggregation\":\"none\",\"grain\":\"one GiftCategory\",\"unit\":\"JPY\"},\"description\":\"Pre-aggregated static Donation amount for this GiftCategory across the full snapshot.\"},\"valueType\":\"BigInt\"},{\"baseTypeNamespaceType\":null,\"id\":\"689954130077529009\",\"name\":\"CategoryAmountRank\",\"redefines\":null,\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"category amount rank\",\"defaultAggregation\":\"none\",\"grain\":\"one GiftCategory\",\"rankMethod\":\"row_number\",\"rankPartition\":\"none (single global window)\",\"rankScope\":\"all GiftCategories\",\"rankSort\":\"CategoryStaticTotalYen desc, CategoryId asc\",\"rankTieBreak\":\"CategoryId ascending\"},\"description\":\"Static donation-amount rank of this GiftCategory across all GiftCategories. Deterministic row-number rank (row_number) over CategoryStaticTotalYen desc, CategoryId asc: equal amounts never share a rank because CategoryId breaks the tie ascending.\"},\"valueType\":\"BigInt\"}],\"semanticEnrichment\":{\"customAttributes\":{\"businessRole\":\"catalog classification dimension\",\"grain\":\"one controlled return-gift category\",\"metricPolicy\":\"aggregate at Donation grain\",\"sensitivity\":\"Public-Synthetic-Catalog\"},\"description\":\"Controlled classification of return-gift options (返礼品カテゴリ). Category counts and amounts must be aggregated from Donation through DonationSelectedGift and GiftInCategory; the category itself is not a transaction fact.\",\"synonyms\":[\"gift category\",\"return-gift category\",\"reward category\",\"benefit category\",\"product category\",\"genre\",\"返礼品カテゴリ\",\"返礼品分類\",\"お礼品カテゴリ\",\"特典カテゴリ\",\"ジャンル\"]},\"timeseriesProperties\":[],\"untypedProperties\":[],\"visibility\":\"Visible\"}" .
