  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Synthetic workshop donor (寄付者／寄附者) who may make zero or more Donations. Residence is defined only by DonorLivesInPrefecture and must never be interpreted as recipient geography.</rdfs:comment>
    <rdfs:label>Donor</rdfs:label>
    <skos:altLabel>contributor</skos:altLabel>
    <skos:altLabel>contributors</skos:altLabel>
    <skos:altLabel>donor</skos:altLabel>
    <skos:altLabel>donors</skos:altLabel>
    <skos:altLabel>hometown tax donor</skos:altLabel>
    <skos:altLabel>supporter</skos:altLabel>
    <skos:altLabel>supporters</skos:altLabel>
    <skos:altLabel>taxpayer</skos:altLabel>
    <skos:altLabel>寄付者</skos:altLabel>
    <skos:altLabel>寄附者</skos:altLabel>
    <skos:altLabel>支援者</skos:altLabel>
    <skos:altLabel>納税者</skos:altLabel>
    <fabric:businessRole>actor dimension</fabric:businessRole>
    <fabric:dataNature>synthetic, no real PII</fabric:dataNature>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json","baseEntityTypeId":null,"displayNamePropertyId":"5348862124906866269","entityIdParts":["5348862125606558677"],"id":"244579893085159","name":"Donor","namespace":"usertypes","namespaceType":"Custom","properties":[{"baseTypeNamespaceType":null,"id":"5348862125606558677","name":"DonorId","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"stable entity identifier","defaultAggregation":"none","format":"integer ID","grain":"one Donor","sensitivity":"Synthetic workshop data"},"description":"Stable numeric identifier for one synthetic Donor entity. Names aren't guaranteed unique, so use this ID to disambiguate people."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"5348862127378029795","name":"DonorName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese label","defaultAggregation":"none","format":"synthetic Japanese name","grain":"one value per Donor","language":"ja-JP","sensitivity":"Synthetic-Personal"},"description":"Synthetic Japanese personal-style name of the donor (寄付者名／支援者名). It is not guaranteed to be unique and does not represent a real person."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5348862124906866269","name":"DonorDisplayName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"display label","defaultAggregation":"none","format":"{DonorName} / Donor {DonorId}","grain":"one value per Donor","language":"ja-JP","sensitivity":"Synthetic-Personal"},"description":"Display-only composite in the format {DonorName} / Donor {DonorId}. Use DonorId for identity and this property for human-readable output."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5348862127284379622","name":"DonorAge","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"demographic attribute","defaultAggregation":"none","format":"integer","grain":"one value per Donor","sensitivity":"Synthetic-Personal","unit":"years","validRange":"20-79"},"description":"Whole-year age of the synthetic donor (年齢) in the static donor record. It is not derived from the Donation timestamp and must not be summed."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"5348862124961957309","name":"DonorOccupation","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese categorical attribute","defaultAggregation":"none","format":"controlled text, 28 values","grain":"one value per Donor","language":"ja-JP","sensitivity":"Synthetic-Personal"},"description":"Japanese controlled occupation or job label (職業／職種／仕事) for the synthetic donor. It describes the donor's job category, not employer, recipient, or Supplier type."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5348862127602868634","name":"DonorOccupationEn","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"canonical English categorical attribute","defaultAggregation":"none","format":"controlled text, 28 values","grain":"one value per Donor","language":"en","sensitivity":"Synthetic-Personal"},"description":"Canonical English occupation label for DonorOccupation. Use it for English filtering and grouping; preserve DonorOccupation when returning the stored Japanese label."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"883258764297272435","name":"DonorStaticCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"donor snapshot metric","defaultAggregation":"none","grain":"one Donor","measure":"count of Donation"},"description":"Pre-aggregated number of static Donations made by this Donor."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"711408154335516719","name":"DonorStaticTotalYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"donor snapshot metric","defaultAggregation":"none","grain":"one Donor","metric":"cumulative amount","unit":"JPY"},"description":"Pre-aggregated cumulative static Donation amount made by this Donor in JPY."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"255991156059311575","name":"DonorStaticMaxYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"donor snapshot metric","defaultAggregation":"none","grain":"one Donor","metric":"single-donation maximum","unit":"JPY"},"description":"Maximum single static Donation amount made by this Donor in JPY; it is not the cumulative amount."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"771382807231525573","name":"DonorOverallAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"cumulative amount rank","defaultAggregation":"none","grain":"one Donor","rankMethod":"row_number","rankPartition":"none (single global window)","rankScope":"all Donors nationwide","rankSort":"DonorStaticTotalYen desc, DonorId asc","rankTieBreak":"DonorId ascending"},"description":"Cumulative static donation-amount rank of this Donor nationwide. Deterministic row-number rank (row_number) over DonorStaticTotalYen desc, DonorId asc: equal amounts never share a rank because DonorId breaks the tie ascending."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"133464920126148669","name":"DonorResidenceAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"cumulative amount rank","defaultAggregation":"none","grain":"one Donor","rankMethod":"row_number","rankPartition":"PrefectureId","rankScope":"within residence Prefecture","rankSort":"DonorStaticTotalYen desc, DonorId asc","rankTieBreak":"DonorId ascending"},"description":"Cumulative static donation-amount rank of this Donor inside the residence Prefecture. Deterministic row-number rank (row_number) over DonorStaticTotalYen desc, DonorId asc within each PrefectureId: equal amounts never share a rank because DonorId breaks the tie ascending."},"valueType":"BigInt"}],"semanticEnrichment":{"customAttributes":{"businessRole":"actor dimension","dataNature":"synthetic, no real PII","geographyRole":"donor residence only","grain":"one synthetic donor","sensitivity":"Synthetic-Personal"},"description":"Synthetic workshop donor (寄付者／寄附者) who may make zero or more Donations. Residence is defined only by DonorLivesInPrefecture and must never be interpreted as recipient geography.","synonyms":["donor","donors","contributor","contributors","supporter","supporters","hometown tax donor","taxpayer","寄付者","寄附者","支援者","納税者"]},"timeseriesProperties":[],"untypedProperties":[],"visibility":"Visible"}</fabric:definitionJson>
    <fabric:definitionPart>EntityTypes/244579893085159/definition.json</fabric:definitionPart>
