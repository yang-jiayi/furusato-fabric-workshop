    <fabric:definitionPart>RelationshipTypes/5557170605401875447/definition.json</fabric:definitionPart>
    <fabric:direction>Donor -&gt; Donation</fabric:direction>
    <fabric:grain>one edge per Donation</fabric:grain>
    <fabric:hasContextualization rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#contextualization_72fc6fa4-db44-4e79-892a-69c8371cabbc" />
    <fabric:relationshipTypeId>5557170605401875447</fabric:relationshipTypeId>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"aggregationGuard":"count target Donation entities and sum their DonationAmountYen","businessRole":"transaction actor","cardinality":"zero-to-many from Donor, exactly one Donor per Donation","direction":"Donor -&gt; Donation","grain":"one edge per Donation","sensitivity":"Synthetic-Transaction","sourceParticipation":"optional - 18 Donors have no Donation","targetParticipation":"mandatory - every Donation has exactly one Donor"},"description":"Connects the Donor associated with a static baseline Donation to that Donation. Every static Donation has exactly one Donor, and a Donor may have zero, one or many static Donations: 18 of the 12,000 Donors made none."}</fabric:semanticEnrichmentJson>
