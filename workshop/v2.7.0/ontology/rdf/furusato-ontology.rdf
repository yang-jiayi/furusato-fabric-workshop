  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Prefecture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Japanese prefecture (都道府県) used in two separate geography paths: recipient geography through Municipality and donor-residence geography through Donor. It is a reference dimension, not a Donation fact grain.</rdfs:comment>
    <rdfs:label>Prefecture</rdfs:label>
    <skos:altLabel>Japanese prefecture</skos:altLabel>
    <skos:altLabel>donor residence prefecture</skos:altLabel>
    <skos:altLabel>prefecture</skos:altLabel>
    <skos:altLabel>prefectures</skos:altLabel>
    <skos:altLabel>recipient prefecture</skos:altLabel>
    <skos:altLabel>都府県</skos:altLabel>
    <skos:altLabel>都道府県</skos:altLabel>
    <fabric:businessRole>reference geography dimension</fabric:businessRole>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json","baseEntityTypeId":null,"displayNamePropertyId":"3906732945075224848","entityIdParts":["3906732946430141805"],"id":"264514858427221","name":"Prefecture","namespace":"usertypes","namespaceType":"Custom","properties":[{"baseTypeNamespaceType":null,"id":"3906732946430141805","name":"PrefectureId","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"stable entity identifier","defaultAggregation":"none","format":"integer ID","grain":"one Prefecture"},"description":"Stable numeric identifier for one Japanese Prefecture entity. Use it to disambiguate names and as the relationship key; do not aggregate it. If the user explicitly asks for a 都道府県 or Prefecture result, keep this grain and never substitute a Municipality."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"3906732945075224848","name":"PrefectureName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese label","defaultAggregation":"none","format":"Japanese text","grain":"one value per Prefecture","language":"ja-JP","sensitivity":"Public"},"description":"Official Japanese display label of the prefecture (都道府県名). Preserve the exact stored Japanese text in output."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"3906732946282367573","name":"PrefectureNameEn","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"English label","defaultAggregation":"none","format":"English text","grain":"one value per Prefecture","language":"en","sensitivity":"Public"},"description":"Canonical English label of the prefecture. Use it for English lookup and display; PrefectureId remains the identity."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"642085434505905178","name":"PrefReceivedStaticCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"received snapshot metric","defaultAggregation":"none","grain":"one Prefecture","measure":"count of Donation","snapshotScope":"current static Donation only"},"description":"Pre-aggregated count of static Donations received by municipalities in this Prefecture."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"353595838155217070","name":"PrefReceivedTotalYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"received snapshot metric","defaultAggregation":"none","grain":"one Prefecture","snapshotScope":"current static Donation only","unit":"JPY"},"description":"Pre-aggregated JPY amount received by municipalities in this Prefecture."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"338837934727905406","name":"PrefReceivedAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"received amount rank","defaultAggregation":"none","grain":"one Prefecture","rankMethod":"row_number","rankPartition":"none (single global window)","rankScope":"all Prefectures","rankSort":"PrefReceivedTotalYen desc, PrefectureId asc","rankTieBreak":"PrefectureId ascending","sort":"amount descending"},"description":"Received-amount rank of this Prefecture across all Prefectures. Deterministic row-number rank (row_number) over PrefReceivedTotalYen desc, PrefectureId asc: equal amounts never share a rank because PrefectureId breaks the tie ascending."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"383347669254185297","name":"PrefResidentStaticCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"resident-origin snapshot metric","defaultAggregation":"none","geographyRole":"donor residence","grain":"one Prefecture","measure":"count of Donation"},"description":"Pre-aggregated count of static Donations made by Donors who live in this Prefecture."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"543556239011356093","name":"PrefResidentTotalYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"resident-origin snapshot metric","defaultAggregation":"none","geographyRole":"donor residence","grain":"one Prefecture","unit":"JPY"},"description":"Pre-aggregated JPY amount donated by Donors who live in this Prefecture."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"741801649727822506","name":"PrefResidentAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"resident-origin amount rank","defaultAggregation":"none","grain":"one Prefecture","rankMethod":"row_number","rankPartition":"none (single global window)","rankScope":"all Prefectures","rankSort":"PrefResidentTotalYen desc, PrefectureId asc","rankTieBreak":"PrefectureId ascending"},"description":"Resident-amount rank of this Prefecture across all Prefectures. Deterministic row-number rank (row_number) over PrefResidentTotalYen desc, PrefectureId asc: equal amounts never share a rank because PrefectureId breaks the tie ascending."},"valueType":"BigInt"}],"semanticEnrichment":{"customAttributes":{"businessRole":"reference geography dimension","geographyRoles":"recipient prefecture and donor-residence prefecture","grain":"one entity per Japanese prefecture","language":"ja-JP,en","sensitivity":"Public"},"description":"Japanese prefecture (都道府県) used in two separate geography paths: recipient geography through Municipality and donor-residence geography through Donor. It is a reference dimension, not a Donation fact grain.","synonyms":["prefecture","prefectures","Japanese prefecture","recipient prefecture","donor residence prefecture","都道府県","都府県"]},"timeseriesProperties":[],"untypedProperties":[],"visibility":"Visible"}</fabric:definitionJson>
