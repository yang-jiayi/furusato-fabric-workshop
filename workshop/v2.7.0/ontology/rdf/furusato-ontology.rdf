  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#ResidencePrefHasFlow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment>Connects the Donor-residence Prefecture to an origin-destination PrefectureDonationFlow row.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Prefecture" />
    <rdfs:label>ResidencePrefHasFlow</rdfs:label>
