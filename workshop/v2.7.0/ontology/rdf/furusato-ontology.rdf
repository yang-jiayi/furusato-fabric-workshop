  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#DonorMadeDonation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment>Connects the Donor associated with a static baseline Donation to that Donation. Every static Donation has exactly one Donor, and a Donor may have zero, one or many static Donations: 18 of the 12,000 Donors made none.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donor" />
    <rdfs:label>DonorMadeDonation</rdfs:label>
    <rdfs:range rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Donation" />
    <fabric:aggregationGuard>count target Donation entities and sum their DonationAmountYen</fabric:aggregationGuard>
    <fabric:businessRole>transaction actor</fabric:businessRole>
    <fabric:cardinality>zero-to-many from Donor, exactly one Donor per Donation</fabric:cardinality>
