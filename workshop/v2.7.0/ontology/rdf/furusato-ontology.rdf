  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Synthetic return-gift option selected by a Donation (返礼品／お礼品／商品). It is a catalog dimension, not the donated money and not a transaction fact. If a Municipality is named, resolve that Municipality and traverse MunicipalityCatalogsGift before applying a GiftName CONTAINS candidate filter. Resolve exactly one stable GiftId before Supplier or Donation traversal.</rdfs:comment>
    <rdfs:label>Gift</rdfs:label>
    <skos:altLabel>benefit</skos:altLabel>
    <skos:altLabel>gift option</skos:altLabel>
    <skos:altLabel>gift</skos:altLabel>
    <skos:altLabel>hometown tax gift</skos:altLabel>
    <skos:altLabel>perk</skos:altLabel>
    <skos:altLabel>return gift</skos:altLabel>
    <skos:altLabel>return gifts</skos:altLabel>
    <skos:altLabel>reward</skos:altLabel>
    <skos:altLabel>thank-you gift</skos:altLabel>
    <skos:altLabel>お礼品</skos:altLabel>
    <skos:altLabel>商品</skos:altLabel>
    <skos:altLabel>特典</skos:altLabel>
    <skos:altLabel>返礼品</skos:altLabel>
    <skos:altLabel>返礼品オプション</skos:altLabel>
    <fabric:businessRole>catalog item dimension</fabric:businessRole>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json","baseEntityTypeId":null,"displayNamePropertyId":"5416054540626218197","entityIdParts":["5416054538545251650"],"id":"21065477330866","name":"Gift","namespace":"usertypes","namespaceType":"Custom","properties":[{"baseTypeNamespaceType":null,"id":"5416054538545251650","name":"GiftId","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"stable entity identifier","defaultAggregation":"none","format":"integer ID","grain":"one Gift"},"description":"Stable numeric identifier for one Gift catalog entity. Use it to connect Donations, catalog Municipalities, categories, and registered Suppliers."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"5416054537989576852","name":"GiftName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese label","defaultAggregation":"none","format":"Japanese text","grain":"one value per Gift","language":"ja-JP","sensitivity":"Public-Synthetic-Catalog"},"description":"Core Japanese product or service name of the return-gift option (返礼品名／お礼品名／商品名). It usually opens with a place-of-origin word such as a prefecture name, which is display text and not authoritative geography. For a Municipality-qualified colloquial label, traverse MunicipalityCatalogsGift first, filter this property with CONTAINS on the core noun, and verify the remaining numeric and descriptive tokens. Core names can repeat, so resolve one stable GiftId before further traversal."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5416054540626218197","name":"GiftDisplayName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"display label","defaultAggregation":"none","format":"{GiftName} / Gift {GiftId}","grain":"one value per Gift","language":"ja-JP","sensitivity":"Public-Synthetic-Catalog"},"description":"Display-only composite in the format {GiftName} / Gift {GiftId}. Use it for unambiguous human-readable output and GiftId as the stable identity."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"196401923428015932","name":"GiftSearchTerms","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"search-only Gift resolver","defaultAggregation":"none","displayPolicy":"never display, group, or aggregate","format":"{GiftName} | {GiftNameEn} | {CategoryName} | {CategoryNameEn}","grain":"one value per Gift","language":"ja-JP,en","queryPattern":"FILTER lower(g.GiftSearchTerms) CONTAINS lower('&lt;distinctive token&gt;') for every supplied token","sensitivity":"Public-Synthetic-Catalog"},"description":"Pipe-delimited search-only text for resolving shortened or colloquial Gift wording. It contains the core GiftName, the English GiftNameEn, the Japanese CategoryName, and the English CategoryNameEn. Place-of-origin words often appear inside those name strings, but they are display text and not authoritative geography, so resolve catalog and recipient geography through MunicipalityCatalogsGift and DonationToMunicipality. Filter it with a case-insensitive substring match for every distinctive noun supplied by the user; never display, group, count, or treat it as Gift identity."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5416054541651706320","name":"GiftNotes","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"descriptive text","defaultAggregation":"none","format":"free text","grain":"one value per Gift","language":"ja-JP","sensitivity":"Public-Synthetic-Catalog"},"description":"Japanese free-text note, notes, remarks, or description for the return-gift option (備考／注意事項／説明). Notes are descriptive only and do not define Supplier, recipient geography, category, or monetary amount."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"770784031709312495","name":"GiftStaticCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"gift snapshot metric","defaultAggregation":"none","grain":"one Gift","measure":"count of Donation","queryPolicy":"select directly from the resolved Gift without traversing any relationship"},"description":"Authoritative pre-aggregated count of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift count; do not join Suppliers or recount Donation detail."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"562907930706153922","name":"GiftStaticTotalYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"gift snapshot metric","defaultAggregation":"none","grain":"one Gift","queryPolicy":"select directly from the resolved Gift without traversing any relationship","unit":"JPY"},"description":"Authoritative pre-aggregated JPY amount of static Donations that selected this Gift. After resolving one GiftId, use this property directly for an all-time Gift total; do not join Suppliers or use SUM(DISTINCT DonationAmountYen)."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"753534949855484163","name":"GiftAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"gift amount rank","defaultAggregation":"none","grain":"one Gift","rankMethod":"row_number","rankPartition":"none (single global window)","rankScope":"all Gifts","rankSort":"GiftStaticTotalYen desc, GiftId asc","rankTieBreak":"GiftId ascending"},"description":"Static donation-amount rank of this Gift across all Gifts. Deterministic row-number rank (row_number) over GiftStaticTotalYen desc, GiftId asc: equal amounts never share a rank because GiftId breaks the tie ascending."},"valueType":"BigInt"}],"semanticEnrichment":{"customAttributes":{"businessRole":"catalog item dimension","grain":"one return-gift option","monetaryRole":"none","recipientPath":"DonationToMunicipality only","sensitivity":"Public-Synthetic-Catalog"},"description":"Synthetic return-gift option selected by a Donation (返礼品／お礼品／商品). It is a catalog dimension, not the donated money and not a transaction fact. If a Municipality is named, resolve that Municipality and traverse MunicipalityCatalogsGift before applying a GiftName CONTAINS candidate filter. Resolve exactly one stable GiftId before Supplier or Donation traversal.","synonyms":["gift","return gift","return gifts","thank-you gift","reward","benefit","perk","gift option","hometown tax gift","返礼品","お礼品","商品","特典","返礼品オプション"]},"timeseriesProperties":[],"untypedProperties":[],"visibility":"Visible"}</fabric:definitionJson>
    <fabric:definitionPart>EntityTypes/21065477330866/definition.json</fabric:definitionPart>
    <fabric:displayNameProperty rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift__GiftDisplayName" />
    <fabric:entityTypeId>21065477330866</fabric:entityTypeId>
    <fabric:grain>one return-gift option</fabric:grain>
    <fabric:hasDataBinding rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#binding_e6799770-bdef-4f21-b261-750e52de1364" />
    <fabric:keyProperty rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Gift__GiftId" />
    <fabric:monetaryRole>none</fabric:monetaryRole>
    <fabric:recipientPath>DonationToMunicipality only</fabric:recipientPath>
    <fabric:semanticEnrichmentJson>{"customAttributes":{"businessRole":"catalog item dimension","grain":"one return-gift option","monetaryRole":"none","recipientPath":"DonationToMunicipality only","sensitivity":"Public-Synthetic-Catalog"},"description":"Synthetic return-gift option selected by a Donation (返礼品／お礼品／商品). It is a catalog dimension, not the donated money and not a transaction fact. If a Municipality is named, resolve that Municipality and traverse MunicipalityCatalogsGift before applying a GiftName CONTAINS candidate filter. Resolve exactly one stable GiftId before Supplier or Donation traversal.","synonyms":["gift","return gift","return gifts","thank-you gift","reward","benefit","perk","gift option","hometown tax gift","返礼品","お礼品","商品","特典","返礼品オプション"]}</fabric:semanticEnrichmentJson>
    <fabric:sensitivity>Public-Synthetic-Catalog</fabric:sensitivity>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#GiftCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Controlled classification of return-gift options (返礼品カテゴリ). Category counts and amounts must be aggregated from Donation through DonationSelectedGift and GiftInCategory; the category itself is not a transaction fact.</rdfs:comment>
    <rdfs:label>GiftCategory</rdfs:label>
    <skos:altLabel>benefit category</skos:altLabel>
    <skos:altLabel>genre</skos:altLabel>
    <skos:altLabel>gift category</skos:altLabel>
    <skos:altLabel>product category</skos:altLabel>
    <skos:altLabel>return-gift category</skos:altLabel>
    <skos:altLabel>reward category</skos:altLabel>
    <skos:altLabel>お礼品カテゴリ</skos:altLabel>
    <skos:altLabel>ジャンル</skos:altLabel>
    <skos:altLabel>特典カテゴリ</skos:altLabel>
    <skos:altLabel>返礼品カテゴリ</skos:altLabel>
    <skos:altLabel>返礼品分類</skos:altLabel>
    <fabric:businessRole>catalog classification dimension</fabric:businessRole>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json","baseEntityTypeId":null,"displayNamePropertyId":"5394698401700544536","entityIdParts":["5394698403364015417"],"id":"135818208486705","name":"GiftCategory","namespace":"usertypes","namespaceType":"Custom","properties":[{"baseTypeNamespaceType":null,"id":"5394698403364015417","name":"CategoryId","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"stable entity identifier","defaultAggregation":"none","format":"integer ID","grain":"one GiftCategory"},"description":"Stable numeric identifier for one GiftCategory entity. Use it with the stored category labels and never sum or average it."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"5394698401700544536","name":"CategoryName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese controlled label","defaultAggregation":"none","format":"controlled text, 30 values","grain":"one value per GiftCategory","language":"ja-JP","sensitivity":"Public-Synthetic-Catalog"},"description":"Canonical Japanese return-gift category label (返礼品カテゴリ／返礼品分類). Category metrics must be calculated from Donation, not from this label."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5394698404119989434","name":"CategoryNameEn","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"canonical English label","defaultAggregation":"none","format":"controlled text, 30 values","grain":"one value per GiftCategory","language":"en","sensitivity":"Public-Synthetic-Catalog"},"description":"Canonical English return-gift category label paired one-to-one with CategoryName. Use it for English filtering, grouping, and display; CategoryId remains the identity."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5394698403117272042","name":"CategorySearchTerms","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"search-only alias index","displayPolicy":"never display, group, or aggregate","format":"{CategoryName} | {CategoryNameEn} | gift category","grain":"one value per GiftCategory","language":"ja-JP,en","queryPattern":"FILTER lower(c.CategorySearchTerms) CONTAINS lower('&lt;alias&gt;')","sensitivity":"Public-Synthetic-Catalog"},"description":"Pipe-delimited alias text holding the Japanese CategoryName, the English CategoryNameEn, and the literal marker gift category. Use it only to resolve colloquial return-gift category wording such as 海鮮系, 魚介, or seafood with a case-insensitive substring match. If CategoryName does not match, query this alias index before claiming no category data. Never display, group, count, or treat this property as the category identity."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"721526931524255498","name":"CategoryStaticCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"category snapshot metric","defaultAggregation":"none","grain":"one GiftCategory","measure":"count of Donation"},"description":"Pre-aggregated static Donation count for this GiftCategory across the full snapshot."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"200890417511184799","name":"CategoryStaticTotalYen","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"category snapshot metric","defaultAggregation":"none","grain":"one GiftCategory","unit":"JPY"},"description":"Pre-aggregated static Donation amount for this GiftCategory across the full snapshot."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"689954130077529009","name":"CategoryAmountRank","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"category amount rank","defaultAggregation":"none","grain":"one GiftCategory","rankMethod":"row_number","rankPartition":"none (single global window)","rankScope":"all GiftCategories","rankSort":"CategoryStaticTotalYen desc, CategoryId asc","rankTieBreak":"CategoryId ascending"},"description":"Static donation-amount rank of this GiftCategory across all GiftCategories. Deterministic row-number rank (row_number) over CategoryStaticTotalYen desc, CategoryId asc: equal amounts never share a rank because CategoryId breaks the tie ascending."},"valueType":"BigInt"}],"semanticEnrichment":{"customAttributes":{"businessRole":"catalog classification dimension","grain":"one controlled return-gift category","metricPolicy":"aggregate at Donation grain","sensitivity":"Public-Synthetic-Catalog"},"description":"Controlled classification of return-gift options (返礼品カテゴリ). Category counts and amounts must be aggregated from Donation through DonationSelectedGift and GiftInCategory; the category itself is not a transaction fact.","synonyms":["gift category","return-gift category","reward category","benefit category","product category","genre","返礼品カテゴリ","返礼品分類","お礼品カテゴリ","特典カテゴリ","ジャンル"]},"timeseriesProperties":[],"untypedProperties":[],"visibility":"Visible"}</fabric:definitionJson>
    <fabric:definitionPart>EntityTypes/135818208486705/definition.json</fabric:definitionPart>
    <fabric:displayNameProperty rdf:resource="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#GiftCategory__CategoryName" />
    <fabric:entityTypeId>135818208486705</fabric:entityTypeId>
