      "checks": ["materialization_completed", "actual_gql_not_sql_substitution", "scope_specific_nodes_edges", "stable_keys_paths_and_grain", "returned_rows_not_generated_query"],
      "required_items": ["ontology"],
      "required_languages": ["GQL"]
    },
    {
      "id": "GRAPH03", "category": "data", "critical": true,
      "title": "Readiness, source watermark and graph freshness",
      "roles": {"ready": "capability_probe", "source": "source_query", "gql": "source_query", "materialization": "operation_receipt"},
