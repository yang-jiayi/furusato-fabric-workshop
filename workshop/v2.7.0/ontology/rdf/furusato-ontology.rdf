  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/yang-jiayi/furusato-fabric-workshop/ontology/furusato#Supplier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Synthetic workshop business that may provide zero or more return-gift options (返礼品提供事業者). It is neither the Donation recipient nor a Donor; location is defined by SupplierInPrefecture.</rdfs:comment>
    <rdfs:label>Supplier</rdfs:label>
    <skos:altLabel>gift supplier</skos:altLabel>
    <skos:altLabel>local business</skos:altLabel>
    <skos:altLabel>merchant</skos:altLabel>
    <skos:altLabel>provider</skos:altLabel>
    <skos:altLabel>providers</skos:altLabel>
    <skos:altLabel>return-gift provider</skos:altLabel>
    <skos:altLabel>supplier</skos:altLabel>
    <skos:altLabel>suppliers</skos:altLabel>
    <skos:altLabel>vendor</skos:altLabel>
    <skos:altLabel>vendors</skos:altLabel>
    <skos:altLabel>ベンダー</skos:altLabel>
    <skos:altLabel>事業者</skos:altLabel>
    <skos:altLabel>加盟店</skos:altLabel>
    <skos:altLabel>提供事業者</skos:altLabel>
    <skos:altLabel>返礼品事業者</skos:altLabel>
    <fabric:businessRole>provider dimension</fabric:businessRole>
    <fabric:definitionJson>{"$schema":"https://developer.microsoft.com/json-schemas/fabric/item/ontology/entityType/1.0.0/schema.json","baseEntityTypeId":null,"displayNamePropertyId":"5445377801538082911","entityIdParts":["5445377799988794015"],"id":"193544498857107","name":"Supplier","namespace":"usertypes","namespaceType":"Custom","properties":[{"baseTypeNamespaceType":null,"id":"5445377799988794015","name":"SupplierId","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"stable entity identifier","defaultAggregation":"none","format":"integer ID","fulfillmentRole":"none","grain":"one Supplier"},"description":"Stable numeric identifier for one synthetic registered Supplier entity. It identifies a catalog provider, not an actual fulfillment event."},"valueType":"BigInt"},{"baseTypeNamespaceType":null,"id":"5445377802529702386","name":"SupplierName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese label","defaultAggregation":"none","format":"synthetic Japanese organization name","grain":"one value per Supplier","language":"ja-JP","sensitivity":"Synthetic-Organization"},"description":"Synthetic Japanese organization-style name of the Supplier or vendor (事業者名／提供事業者名). It is not a Donation recipient."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5445377801538082911","name":"SupplierDisplayName","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"display label","defaultAggregation":"none","format":"{SupplierName} / Supplier {SupplierId}","grain":"one value per Supplier","language":"ja-JP","sensitivity":"Synthetic-Organization"},"description":"Display-only composite in the format {SupplierName} / Supplier {SupplierId}. Use SupplierId for identity and this property for human-readable output."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5445377802853967813","name":"SupplierType","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"Japanese categorical attribute","defaultAggregation":"none","format":"controlled text, 28 values","grain":"one value per Supplier","language":"ja-JP","sensitivity":"Synthetic-Organization"},"description":"Japanese controlled supplier classification or business-type label (事業者種別／事業者区分) for the Supplier or vendor. It describes the provider, not the Gift category or Donation recipient."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"5445377799612701995","name":"SupplierTypeEn","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"canonical English categorical attribute","defaultAggregation":"none","format":"controlled text, 28 values","grain":"one value per Supplier","language":"en","sensitivity":"Synthetic-Organization"},"description":"Canonical English business-type label for SupplierType. Use it for English filtering and grouping; it describes the provider and not the Gift category or Donation recipient."},"valueType":"String"},{"baseTypeNamespaceType":null,"id":"182924195658098576","name":"SupplierProvidedGiftCount","redefines":null,"semanticEnrichment":{"customAttributes":{"businessRole":"catalog relationship count","defaultAggregation":"none","fulfillmentRole":"none","grain":"one Supplier","measure":"count of registered Gift links","monetaryRole":"none"},"description":"Count of distinct Gifts linked to this Supplier in the registered catalog; it is not a Donation or fulfillment metric."},"valueType":"BigInt"}],"semanticEnrichment":{"customAttributes":{"businessRole":"provider dimension","grain":"one synthetic supplier","locationRole":"supplier base prefecture","metricPolicy":"supplier allocation is not defined","sensitivity":"Synthetic-Organization"},"description":"Synthetic workshop business that may provide zero or more return-gift options (返礼品提供事業者). It is neither the Donation recipient nor a Donor; location is defined by SupplierInPrefecture.","synonyms":["supplier","suppliers","vendor","vendors","provider","providers","merchant","local business","return-gift provider","gift supplier","事業者","提供事業者","返礼品事業者","ベンダー","加盟店"]},"timeseriesProperties":[],"untypedProperties":[],"visibility":"Visible"}</fabric:definitionJson>
    <fabric:definitionPart>EntityTypes/193544498857107/definition.json</fabric:definitionPart>
